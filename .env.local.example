DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# better-auth
BETTER_AUTH_SECRET=<stringa-random-almeno-32-caratteri>
BETTER_AUTH_URL=http://localhost:3000
# Public URL of the app, read at runtime (GoCardless callback). In production: https://<domain>
APP_URL=http://localhost:3000

# Google OAuth — credentials from Google Cloud Console (OAuth 2.0)
# Redirect URI to add: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=<id-cliente-google>
GOOGLE_CLIENT_SECRET=<secret-cliente-google>

# Resend — API key from the resend.com dashboard
RESEND_API_KEY=re_<api-key>
RESEND_FROM=noreply@buddybudget.app

# GoCardless Bank Account Data (Open Banking) — https://bankaccountdata.gocardless.com
# Sandbox credentials to create at https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=<secret-id-sandbox>
GOCARDLESS_SECRET_KEY=<secret-key-sandbox>

# Cleanup of GoCardless connections (cron /api/cron/gocardless-maintenance), optional.
# GOCARDLESS_CLEANUP_MODE: off | dry-run (default: counts without deleting) | execute.
# GOCARDLESS_CLEANUP_DELETE_UNKNOWN=true also deletes what on GoCardless is not in the DB: do NOT enable it
# if another environment uses the same GoCardless account.
GOCARDLESS_CLEANUP_MODE=dry-run
# Cap on bank connections (GoCardless free plan: 50). Empty = default 1 / 3 / 40 / 50.
# Banks per person, consents per person in 31 days, slots for new banks, plan limit (renewals can go up to it).
GOCARDLESS_MAX_CONNECTIONS_PER_USER=
GOCARDLESS_MAX_ATTEMPTS_PER_USER=
GOCARDLESS_MAX_CONNECTIONS=
GOCARDLESS_PROVIDER_LIMIT=
# New bank connections: true = open, false = only renewals of banks already linked («In arrivo» + «Tienimi
# aggiornato» in the app). Empty = closed on the hosted version, open when SELF_HOSTED=true.
BANK_CONNECTIONS_OPEN=

# Redis — rate limiting of the GoCardless sync (e.g. `docker run -p 6379:6379 redis`)
REDIS_URL=redis://localhost:6379

# Assisted categorisation (optional): without these variables the layer is simply off
# and categorisation stays purely deterministic (rules + similarity).
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Secret shared with whoever calls /api/cron/* (Vercel Cron today, k8s CronJob after the migration).
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=<stringa-random-almeno-32-caratteri>

# Observability (optional).
# LOG_LEVEL: debug|info|warn|error (default info; debug with `pnpm dev`).
LOG_LEVEL=
# Token for scraping /api/metrics (Alloy in the cluster). At least 32 characters; empty = endpoint off (404).
METRICS_TOKEN=
# Secret to pseudonymise user ids in logs (HMAC). Empty = plain sha256. Changing it breaks log continuity.
LOG_HASH_SECRET=

# Optional: Logo.dev public key (pk_…) for stock and ETF logos in Investimenti. Without it, only local icons.
LOGODEV_PUBLISHABLE_KEY=
# Optional: Logo.dev secret key (sk_…) to search by name for logos of merchants seen across several users (uses
# credits, at most 100 searches per day). Without it, logos come only from the dictionary and from the website written in transactions.
LOGODEV_SECRET_KEY=

# Optional: encrypts in the database transaction descriptions and notes, debt and investment notes and the GoCardless token
# (32 random bytes in base64: `openssl rand -base64 32`). Once used it must not be lost or changed: without it, that data cannot
# be read back. Already stored data is encrypted with `pnpm db:encrypt-fields --execute`.
DATA_ENCRYPTION_KEY=

# Personal CSVs: app and worker must share the same key (32 random bytes, base64).
# Keep it in the secrets; do not rotate it without migrating the encrypted parsers.
PERSONAL_CSV_ENCRYPTION_KEY=
# Worker only: choose a model compatible with JSON mode and ZDR providers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Category suggestions (Jev on OpenRouter): require OPENROUTER_API_KEY in the web pod and the user's consent in Impostazioni (Settings).
# CATEGORIZATION_MODEL is optional (default typesafe/jev-1.13).
# CATEGORIZATION_MODEL=typesafe/jev-1.13
# «Chiedi all'AI» in Cerca (a sentence the rules cannot read becomes a form): same key and consent; the model is
# COMMANDS_MODEL if set, else OPENROUTER_MODEL (it must answer in JSON mode). Without either, the AI row says it is unavailable.
# COMMANDS_MODEL=deepseek/deepseek-v4.1-flash

# Summary and alert emails (cron /api/cron/notifications), optional.
# NOTIFICATIONS_MODE: off | dry-run (default: computes and counts, does not send) | execute (actually sends to those who enabled them).
NOTIFICATIONS_MODE=dry-run

# Inactive accounts (cron /api/cron/inactive-accounts): warning after 83 days without sign-in, deletion at 90.
# INACTIVITY_CLEANUP_MODE: off | dry-run (default: counts, neither sends nor deletes) | execute (sends the warnings and actually deletes).
INACTIVITY_CLEANUP_MODE=dry-run

# Public demo (/demo): four shared read-only sample accounts (Italy in Italian and English, Germany in English and German), rebuilt by the cron /api/cron/public-demo.
# Off unless "true"; run the cron once after enabling it, before linking to /demo.
# PUBLIC_DEMO_ENABLED=true

# Direct Trade Republic cash connection requires DATA_ENCRYPTION_KEY (32 bytes, base64).
# PIN/phone are used only during sign-in; the authenticated session is encrypted server-side.
# Override only when Trade Republic changes its private web client headers:
# TRADE_REPUBLIC_APP_VERSION=2.2631.13
# TRADE_REPUBLIC_USER_AGENT=
