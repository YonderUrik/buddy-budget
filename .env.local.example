DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# better-auth
BETTER_AUTH_SECRET=<stringa-random-almeno-32-caratteri>
BETTER_AUTH_URL=http://localhost:3000
# URL pubblico dell'app, letto a runtime (ritorno dalla banca, /api/bank/callback). In produzione: https://<dominio>
APP_URL=http://localhost:3000

# Google OAuth — credenziali da Google Cloud Console (OAuth 2.0)
# Redirect URI da aggiungere: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=<id-cliente-google>
GOOGLE_CLIENT_SECRET=<secret-cliente-google>

# Resend — API key dal dashboard resend.com
RESEND_API_KEY=re_<api-key>
RESEND_FROM=noreply@buddybudget.app

# GoCardless Bank Account Data (Open Banking) — https://bankaccountdata.gocardless.com
# Credenziali sandbox da creare su https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=<secret-id-sandbox>
GOCARDLESS_SECRET_KEY=<secret-key-sandbox>

# Enable Banking (Open Banking), alternativa a GoCardless — https://enablebanking.com/cp/applications
# Id dell'applicazione e chiave privata RSA (PEM, PEM con \n letterali o base64). URL di ritorno da registrare:
# <APP_URL>/api/bank/callback. In modalità ristretta funzionano solo i conti collegati nel pannello di Enable Banking.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Fornitore dei collegamenti NUOVI e dei rinnovi: gocardless | enablebanking. Vuoto = GoCardless se configurato,
# altrimenti Enable Banking. I collegamenti esistenti restano sul loro fornitore fino al rinnovo.
BANK_DATA_PROVIDER=

# Pulizia delle connessioni bancarie (cron /api/cron/bank-maintenance), opzionale.
# BANK_CLEANUP_MODE (o il vecchio GOCARDLESS_CLEANUP_MODE): off | dry-run (default: conta senza eliminare) | execute.
# GOCARDLESS_CLEANUP_DELETE_UNKNOWN=true elimina anche ciò che su GoCardless non risulta a DB: NON attivarlo
# se un altro ambiente usa lo stesso account GoCardless.
BANK_CLEANUP_MODE=dry-run
# Tetto dei collegamenti bancari, per fornitore (piano gratuito GoCardless: 50). Vuoti = default 1 / 3 / 40 / 50.
# Banche per persona, consensi per persona in 31 giorni, posti per banche nuove, limite del piano (i rinnovi arrivano fin qui).
# Valgono anche i vecchi nomi GOCARDLESS_MAX_*.
BANK_MAX_CONNECTIONS_PER_USER=
BANK_MAX_ATTEMPTS_PER_USER=
BANK_MAX_CONNECTIONS=
BANK_PROVIDER_LIMIT=

# Redis — rate limiting del sync bancario (es. `docker run -p 6379:6379 redis`)
REDIS_URL=redis://localhost:6379

# Categorizzazione assistita (opzionale): senza queste variabili il livello è semplicemente spento
# e la categorizzazione resta puramente deterministica (regole + somiglianza).
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Segreto condiviso con chi chiama /api/cron/* (Vercel Cron oggi, CronJob k8s dopo la migrazione).
# Almeno 32 caratteri. Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=<stringa-random-almeno-32-caratteri>

# Osservabilità (opzionali).
# LOG_LEVEL: debug|info|warn|error (default info; debug con `pnpm dev`).
LOG_LEVEL=
# Token per lo scrape di /api/metrics (Alloy nel cluster). Almeno 32 caratteri; vuoto = endpoint spento (404).
METRICS_TOKEN=
# Segreto per pseudonimizzare gli id utente nei log (HMAC). Vuoto = sha256 semplice. Cambiarlo spezza la continuità dei log.
LOG_HASH_SECRET=

# Facoltativa: chiave pubblica (pk_…) di Logo.dev per i loghi di azioni ed ETF in Investimenti. Senza, solo icone locali.
LOGODEV_PUBLISHABLE_KEY=
# Facoltativa: chiave segreta (sk_…) di Logo.dev per cercare per nome i loghi degli esercenti visti in più utenti (consuma
# crediti, al massimo 100 ricerche al giorno). Senza, i loghi vengono solo dal dizionario e dal sito scritto nei movimenti.
LOGODEV_SECRET_KEY=

# Facoltativa: cifra nel database descrizioni e note dei movimenti, note di debiti e investimenti e il token GoCardless
# (32 byte casuali in base64: `openssl rand -base64 32`). Una volta usata non va persa né cambiata: senza, quei dati non si
# rileggono. I dati già salvati si cifrano con `pnpm db:encrypt-fields --execute`.
DATA_ENCRYPTION_KEY=

# CSV personali: app e worker devono condividere la stessa chiave (32 byte casuali, base64).
# Conservala nei secret; non ruotarla senza migrare i parser cifrati.
PERSONAL_CSV_ENCRYPTION_KEY=
# Solo worker: scegli un modello compatibile con JSON mode e provider ZDR.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Proposte di categoria (Jev su OpenRouter): servono OPENROUTER_API_KEY nel pod web e il consenso dell'utente in Impostazioni.
# CATEGORIZATION_MODEL è facoltativo (default typesafe/jev-1.13).
# CATEGORIZATION_MODEL=typesafe/jev-1.13

# Email di riepilogo e avvisi (cron /api/cron/notifications), opzionale.
# NOTIFICATIONS_MODE: off | dry-run (default: calcola e conta, non invia) | execute (invia davvero a chi le ha attivate).
NOTIFICATIONS_MODE=dry-run

# Account inattivi (cron /api/cron/inactive-accounts): avviso a 83 giorni senza accessi, eliminazione a 90.
# INACTIVITY_CLEANUP_MODE: off | dry-run (default: conta, non invia né elimina) | execute (invia gli avvisi ed elimina davvero).
INACTIVITY_CLEANUP_MODE=dry-run
