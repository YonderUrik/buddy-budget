# Configurazione di BuddyBudget in self-hosting (docker compose). Copia in `.env` con ./scripts/selfhost-init.sh,
# che genera da solo i segreti. Non committare mai `.env`.

# ---- Obbligatorie (le genera selfhost-init.sh) ----
POSTGRES_PASSWORD=
# Almeno 32 caratteri casuali. Cambiarlo invalida le sessioni aperte.
BETTER_AUTH_SECRET=
# Almeno 32 caratteri casuali. Protegge gli endpoint dei lavori periodici (il servizio `cron` lo usa da solo).
CRON_SECRET=

# ---- Indirizzo pubblico ----
# L'URL con cui apri l'app nel browser, senza slash finale. Dietro un reverse proxy: https://budget.esempio.it
# Serve identico a login (magic link), callback bancarie e cookie: se è sbagliato l'accesso non funziona.
APP_URL=http://localhost:3000
# Porta e interfaccia pubblicate dal container. 127.0.0.1 = solo questa macchina (consigliato dietro un proxy).
APP_PORT=3000
APP_BIND=127.0.0.1

# ---- Versione ----
# latest = ultima release. Per bloccarti su una versione: 0.44.2 (vedi le release su GitHub).
BUDDYBUDGET_VERSION=latest

# ---- Facoltative: lasciale vuote per partire subito ----
# Email (Resend, resend.com). Vuoto = il link di accesso compare nei log: `docker compose logs app`.
# Senza Resend non partono nemmeno gli avvisi di prezzo, le email dell'account e le segnalazioni.
RESEND_API_KEY=
RESEND_FROM=

# Accesso con Google (Google Cloud Console → OAuth 2.0).
# URI di reindirizzamento da registrare: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Collegamento alle banche (GoCardless Bank Account Data, bankaccountdata.gocardless.com). Vuoto = niente
# conti collegati: restano conti manuali e import CSV.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# debug | info | warn | error
LOG_LEVEL=info
