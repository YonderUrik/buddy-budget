# BuddyBudget self-host configuration. Run ./scripts/selfhost-init.sh for guided setup.
# The installer creates .env and generates secrets. Never commit .env.

# ---- Required: generated by the installer ----
POSTGRES_PASSWORD=
# At least 32 random characters. Changing this signs everyone out.
BETTER_AUTH_SECRET=
# At least 32 random characters. Protects the scheduled-job endpoints.
CRON_SECRET=
SELF_HOSTED=true

# ---- Your address ----
# The URL you open in your browser. Behind a reverse proxy: https://budget.example.com
# Sign-in links and bank callbacks must use this same address.
APP_URL=http://localhost:3000
# Local port and network interface exposed by Docker.
# 127.0.0.1 means this computer only; use a reverse proxy for HTTPS.
APP_PORT=3000
APP_BIND=127.0.0.1

# ---- Version ----
# latest follows the latest published image. Use a release tag to pin a version.
BUDDYBUDGET_VERSION=latest

# ---- Recommended: AI categories and custom CSV imports ----
# Create a key at https://openrouter.ai/settings/keys and add account credit.
# Each person must also enable AI suggestions in their own Settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
CATEGORIZATION_MODEL=typesafe/jev-1.13
# Shared by the app and worker. Generated by the installer; do not lose or rotate it.
# Manual generation: openssl rand -base64 32
PERSONAL_CSV_ENCRYPTION_KEY=
# The installer sets ai when OpenRouter is configured. Empty means the worker is off.
COMPOSE_PROFILES=

# ---- Email (recommended) ----
# Create a key at https://resend.com/api-keys and verify your sender domain.
# Without email, find sign-in links with: docker compose logs app
RESEND_API_KEY=
RESEND_FROM=
# off | dry-run | execute. The installer enables execute when email is configured.
# Each person chooses their own notifications; all are off until they opt in.
NOTIFICATIONS_MODE=off

# ---- Google sign-in (optional) ----
# Register this OAuth redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Bank sync (optional) ----
# Credentials from https://bankaccountdata.gocardless.com/
# Without bank sync, manual accounts and CSV imports remain available.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# ---- Additional price providers (optional) ----
# Yahoo Finance, Borsa Italiana, Kraken and ECB exchange rates need no keys.
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
STOOQ_API_KEY=
COINGECKO_API_KEY=
OPENFIGI_API_KEY=

# ---- Other optional integrations ----
LOGODEV_PUBLISHABLE_KEY=
LOGODEV_SECRET_KEY=
# Your own reports inbox. Empty disables support emails on self-hosted instances.
SUPPORT_EMAIL_TO=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
# Optional field encryption: 32 bytes in base64. Never change a key already in use.
DATA_ENCRYPTION_KEY=

# debug | info | warn | error
LOG_LEVEL=info
