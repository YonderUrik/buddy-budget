# BuddyBudget self-hosting configuration (docker compose). Copy to `.env` with ./scripts/selfhost-init.sh,
# which generates the secrets by itself. Never commit `.env`.

# ---- Required (generated by selfhost-init.sh) ----
POSTGRES_PASSWORD=
# At least 32 random characters. Changing it invalidates open sessions.
BETTER_AUTH_SECRET=
# At least 32 random characters. Protects the periodic job endpoints (the `cron` service uses it by itself).
CRON_SECRET=

# ---- Public address ----
# The URL you open the app with in the browser, without a trailing slash. Behind a reverse proxy: https://budget.esempio.it
# Must be identical for sign-in (magic link), bank callbacks and cookies: if it is wrong, sign-in does not work.
APP_URL=http://localhost:3000
# Port and interface published by the container. 127.0.0.1 = this machine only (recommended behind a proxy).
APP_PORT=3000
APP_BIND=127.0.0.1

# ---- Version ----
# latest = latest release. To pin a version: 0.44.2 (see the releases on GitHub).
BUDDYBUDGET_VERSION=latest

# ---- Optional: leave them empty to get started right away ----
# Email (Resend, resend.com). Empty = the sign-in link appears in the logs: `docker compose logs app`.
# Without Resend, price alerts, account emails and reports are not sent either.
RESEND_API_KEY=
RESEND_FROM=

# Sign-in with Google (Google Cloud Console → OAuth 2.0).
# Redirect URI to register: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bank connection (GoCardless Bank Account Data, bankaccountdata.gocardless.com). Empty = no
# linked accounts: manual accounts and CSV import remain.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# debug | info | warn | error
LOG_LEVEL=info
