# BuddyBudget self-hosting configuration (docker compose). Create `.env` with ./scripts/selfhost-init.sh,
# which generates the secrets by itself. Never commit `.env`; keep a copy of it with your backups.

# ---- Required (generated by selfhost-init.sh) ----
POSTGRES_PASSWORD=
# At least 32 random characters. Changing it signs everyone out (no data is lost).
BETTER_AUTH_SECRET=
# At least 32 random characters. Protects the periodic job endpoints (the `cron` service uses it by itself).
CRON_SECRET=

# ---- Public address ----
# The URL you open the app with in the browser, without a trailing slash. Behind a reverse proxy: https://budget.example.com
# Sign-in only works from this exact address (cookies and the origin check depend on it).
APP_URL=http://localhost:3000
# Port and interface published by the container. 127.0.0.1 = this machine only (recommended behind a proxy);
# 0.0.0.0 = the local network too (then APP_URL must be the address the other devices use, e.g. http://192.168.1.20:3000).
APP_PORT=3000
APP_BIND=127.0.0.1

# ---- Version ----
# latest = latest release. To pin a version: 0.79.0 (see the releases on GitHub).
BUDDYBUDGET_VERSION=latest

# ---- Accounts ----
# Sign-in is with email and password. Only the first account can sign up by itself; true = anyone who reaches the
# app can create an account. To add one person without opening signups: docker compose run --rm migrate pnpm auth:create-user their@email
ALLOW_SIGNUPS=
# false = no password sign-in, only the emailed link (needs an email service below). Empty = password on.
AUTH_PASSWORD=

# ---- Optional: leave them empty to get started right away ----
# Email. Without it the app works the same, but sends no emails: no sign-in links, no «forgot password» links
# (reset it with `docker compose run --rm migrate pnpm auth:reset-password you@example.com`), no alerts or summaries.
# Any SMTP server works, e.g. smtps://user:password@smtp.example.com:465 or smtp://user:password@smtp.example.com:587
# (special characters in the password must be URL-encoded: @ → %40, : → %3A).
SMTP_URL=
EMAIL_FROM=
# Or Resend (resend.com) instead of SMTP: then EMAIL_FROM is the sender on your Resend domain.
RESEND_API_KEY=
# Where in-app reports («Scrivici») go. Empty = reports are off on this install.
SUPPORT_EMAIL_TO=

# Sign-in with Google (Google Cloud Console → OAuth 2.0). Redirect URI to register: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (OpenRouter, openrouter.ai): category suggestions, sentences in «Cerca» and the import of any bank CSV. Broker exports (IBKR, DEGIRO,
# Trade Republic, Fineco) import without it. The CSV import also needs its worker: set COMPOSE_PROFILES=ai below.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# COMPOSE_PROFILES=ai
# Encrypts the uploaded CSVs while they wait for the worker (generated by selfhost-init.sh).
PERSONAL_CSV_ENCRYPTION_KEY=

# Bank connection (GoCardless Bank Account Data). GoCardless no longer accepts new sign-ups: this works only if you
# already have keys. Without it: manual accounts and CSV import.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# New bank connections are open by default on a self-hosted install; false = only renewals of banks already linked.
BANK_CONNECTIONS_OPEN=

# Encrypts transaction descriptions and notes in the database: openssl rand -base64 32. Once set, never change or
# remove it, and keep it apart from the backups (without it they cannot be read).
DATA_ENCRYPTION_KEY=

# debug | info | warn | error
LOG_LEVEL=info
