# Configurazione di BuddyBudget in self-hosting (docker compose). Copia in `.env` con ./scripts/selfhost-init.sh,
# che genera da solo i segreti. Non committare mai `.env`.

# ---- Obbligatorie (le genera selfhost-init.sh) ----
POSTGRES_PASSWORD=
# Almeno 32 caratteri casuali. Cambiarlo invalida le sessioni aperte.
BETTER_AUTH_SECRET=
# Almeno 32 caratteri casuali. Protegge gli endpoint dei lavori periodici (il servizio `cron` lo usa da solo).
CRON_SECRET=
SELF_HOSTED=true

# ---- Indirizzo pubblico ----
# L'URL con cui apri l'app nel browser, senza slash finale. Dietro un reverse proxy: https://budget.esempio.it
# Serve identico a login (magic link), callback bancarie e cookie: se è sbagliato l'accesso non funziona.
APP_URL=http://localhost:3000
# Porta e interfaccia pubblicate dal container. 127.0.0.1 = solo questa macchina (consigliato dietro un proxy).
APP_PORT=3000
APP_BIND=127.0.0.1

# ---- Versione ----
# latest = ultima release. Per bloccarti su una versione: 0.44.2 (vedi le release su GitHub).
BUDDYBUDGET_VERSION=latest

# ---- Consigliata: AI (categorie e CSV personali) ----
# Crea una chiave su https://openrouter.ai/settings/keys e aggiungi credito.
# Le proposte di categoria richiedono anche il consenso nelle Impostazioni di ogni utente.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
CATEGORIZATION_MODEL=typesafe/jev-1.13
# App e worker condividono questa chiave: non perderla né cambiarla dopo il primo import.
# Il wizard la genera. Configurazione manuale: openssl rand -base64 32
PERSONAL_CSV_ENCRYPTION_KEY=
# Il wizard imposta ai se è configurato OpenRouter; vuoto = worker spento.
COMPOSE_PROFILES=

# ---- Facoltative: lasciale vuote per partire subito ----
# Email (Resend, resend.com). Vuoto = il link di accesso compare nei log: `docker compose logs app`.
# Senza Resend non partono nemmeno gli avvisi di prezzo, le email dell'account e le segnalazioni.
RESEND_API_KEY=
RESEND_FROM=
# off | dry-run | execute. Il wizard abilita execute con email configurata.
# Ogni utente sceglie quali notifiche ricevere, inizialmente disattivate.
NOTIFICATIONS_MODE=off

# Accesso con Google (Google Cloud Console → OAuth 2.0).
# URI di reindirizzamento da registrare: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Collegamento alle banche (GoCardless Bank Account Data, bankaccountdata.gocardless.com). Vuoto = niente
# conti collegati: restano conti manuali e import CSV.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# ---- Fonti prezzi ----
# Yahoo Finance, Borsa Italiana, Kraken e cambi BCE non richiedono chiavi.
# Queste sono fonti aggiuntive, non indispensabili per iniziare.
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
STOOQ_API_KEY=
COINGECKO_API_KEY=
OPENFIGI_API_KEY=

# ---- Altre integrazioni facoltative ----
LOGODEV_PUBLISHABLE_KEY=
LOGODEV_SECRET_KEY=
# Destinazione delle segnalazioni dell’istanza. Vuoto = invio al supporto disattivato in self-hosting.
SUPPORT_EMAIL_TO=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
# Facoltativa, 32 byte in base64. Non cambiare se già usata.
DATA_ENCRYPTION_KEY=

# debug | info | warn | error
LOG_LEVEL=info
