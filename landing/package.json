{
  "name": "buddy-budget-landing",
  "version": "0.89.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Landing page di BuddyBudget (buddybudget.io): sito statico, deploy separato dall'app.",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "node scripts/pull-screens.mjs --if-missing && next dev --port 3100",
    "build": "node scripts/pull-screens.mjs --if-missing && node scripts/page-dates.mjs && next build && node scripts/generate-markdown.mjs",
    "lint": "eslint",
    "typecheck": "node scripts/pull-screens.mjs --if-missing && tsc --noEmit",
    "test": "node scripts/pull-screens.mjs --if-missing && vitest run",
    "sync:features": "node scripts/sync-features.mjs",
    "capture:screens": "node --experimental-strip-types scripts/capture-screens.mjs",
    "check:features": "node scripts/sync-features.mjs --check",
    "screens:pull": "node scripts/pull-screens.mjs",
    "screens:push": "node scripts/push-screens.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/sofia-sans-extra-condensed": "5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "turndown": "^7.2.4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
