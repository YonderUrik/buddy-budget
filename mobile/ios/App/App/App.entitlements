<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: the magic link in the email opens the app (verified by /.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.buddybudget.io</string>
	</array>
	<!-- Push notifications (APNs). Xcode sets "production" in archives distributed through TestFlight and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple: required by App Store guideline 4.8 next to Google sign-in. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
