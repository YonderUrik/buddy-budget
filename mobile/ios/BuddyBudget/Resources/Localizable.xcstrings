    "the_simulation_generates_0_possible_futu_906be0" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Simulation erzeugt %1$@ mögliche Zukunftsverläufe mit zufälligen Renditen um jährlich %2$@ und einer Volatilität von %3$@ und verfolgt dein Vermögen in jedem Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The simulation generates %1$@ possible futures with random returns around %2$@ annually and volatility of %3$@, tracking your wealth in each one."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La simulazione genera %1$@ futuri possibili, ognuno con rendimenti che oscillano a caso attorno al %2$@ annuo con una volatilità del %3$@, e guarda come va il tuo patrimonio in ciascuno."
          }
        }
      }
    },
    "the_sliders_savings_spending_return_with_74522f" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Regler für Sparen, Ausgaben, Rendite und Entnahme testen Annahmen, ohne sie zu speichern. Jahr und Ergebnisse aktualisieren sich sofort und zeigen den Unterschied zu den gespeicherten Annahmen. „Diese Annahmen speichern“ übernimmt sie, „Zurücksetzen“ verwirft sie. Ohne manuelle Eingabe stammen Ausgaben, Ersparnisse und Rendite aus dem gewählten Zeitraum über den Reglern (12 Monate, 24 Monate oder eigene Monate). Weitere Annahmen findest du unter „Alle Annahmen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sliders (savings, spending, return, withdrawal) try assumptions without saving them. The year and answers update immediately and show the difference from your saved assumptions. “Save these assumptions” makes them permanent; “Reset” discards them. Unless entered manually, spending, savings and returns come from the period selected above the sliders (last 12 months, 24 months or custom months). Other assumptions are under “All assumptions”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I cursori (risparmio, spesa, rendimento, prelievo) provano un'ipotesi senza salvarla: l'anno e le risposte si aggiornano subito e ti dicono quanto guadagni o perdi rispetto a quelle salvate. «Salva queste ipotesi» le rende definitive, «Ripristina» le annulla. Spesa, risparmio e rendimento, se non li hai scritti tu, vengono dai tuoi dati del periodo che scegli sopra i cursori (ultimi 12 mesi, 24 o mesi a scelta); le altre ipotesi sono in «Tutte le ipotesi»."
          }
        }
      }
    },
    "the_solid_bar_shows_risk_weight_the_mark_6c4542" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Balken zeigt den Risikoanteil, die Markierung den Wertanteil. Reicht der Balken darüber hinaus, trägt die Position mehr zum Risiko als zum Portfoliowert bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The solid bar shows risk weight; the marker shows value weight. A bar beyond the marker means the position contributes more to risk than to portfolio value."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra piena è il peso sul rischio, il trattino il peso sul valore: se la barra supera il trattino, quella posizione pesa sul rischio più di quanto pesi sul valore."
          }
        }
      }
    },
