    "deduction_percentages_are_your_assumptio_443e4e" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abzugssätze sind deine Annahmen, keine berechneten deutschen Steuersätze. Nominale Renten bleiben konstant und verlieren durch Inflation an Kaufkraft. Wähle je Vertrag Kapitalauszahlung oder Monatsrente, um Doppelzählung zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deduction percentages are your assumptions, not calculated German tax rates. Nominal pensions are held constant and lose purchasing power with inflation. Choose either a lump sum or monthly income per contract to avoid counting it twice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deduction percentages are your assumptions, not calculated German tax rates. Nominal pensions are held constant and lose purchasing power with inflation. Choose either a lump sum or monthly income per contract to avoid counting it twice."
          }
        }
      }
    },
