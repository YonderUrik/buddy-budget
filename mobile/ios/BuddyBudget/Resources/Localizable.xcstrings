    "uses_the_official_2026_base_rate_of_3_20_69f782" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet den amtlichen Basiszins 2026 von 3,20 %%. Für einen unveränderten, bis Jahresende gehaltenen Bestand; beide Werte beziehen sich auf dieselbe Stückzahl. Die Vorabpauschale fließt 2027 zu. Eine Steuerberechnung für 2027 folgt erst nach Prüfung der Regeln für dieses Jahr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the official 2026 base rate of 3.20%%. For one unchanged lot held through year-end; values use the same number of units. The advance is received in 2027. No 2027 tax estimate is shown until that year's rules are validated."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the official 2026 base rate of 3.20%%. For one unchanged lot held through year-end; values use the same number of units. The advance is received in 2027. No 2027 tax estimate is shown until that year's rules are validated."
          }
        }
      }
    },
