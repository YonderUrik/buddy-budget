    "returns_are_independent_between_years_an_f052db" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renditen sind zwischen Jahren unabhängig und folgen einer regelmäßigen Verteilung. In Wirklichkeit treten extreme Ergebnisse und lange schwache Marktphasen häufiger auf. Das Ergebnis hängt stark vom angenommenen Mittelwert und der Volatilität ab: Annahmen, keine Prognosen. Historische Daten werden nicht verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns are independent between years and follow a regular distribution. Reality has more extreme outcomes and long weak markets. Results depend heavily on assumed mean and volatility; these are assumptions, not forecasts. Historical data is not used."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendimenti indipendenti da un anno all'altro e distribuiti in modo regolare: la realtà ha code più pesanti e periodi lunghi di mercati deboli. Il risultato dipende molto da media e volatilità ipotizzate, che sono tue assunzioni, non previsioni. Non usa dati storici."
          }
        }
      }
    },
