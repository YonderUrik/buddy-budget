    "use_available_loss_balances_only_cross_b_d6b5da" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende nur verfügbare Verlustsalden; für bankübergreifende Verrechnung können Verlustbescheinigung und Veranlagung nötig sein. Erfasse denselben externen Ertrag nicht gleichzeitig als verbrauchten Pauschbetrag und zusätzlichen Ertrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use available loss balances only; cross-bank offsets may require a loss certificate and assessment. Do not enter the same external income both as used allowance and additional income."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use available loss balances only; cross-bank offsets may require a loss certificate and assessment. Do not enter the same external income both as used allowance and additional income."
          }
        }
      }
    },
    "use_one_combined_avd_scenario_per_person_d9c1a9" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende ein zusammengefasstes AVD-Szenario pro Person, damit Zulagen nicht doppelt gezählt werden. Die Auszahlung muss nach dem ersten Beitragsjahr beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use one combined AVD scenario per person to avoid duplicate allowances. Payout must start after the first contribution year."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use one combined AVD scenario per person to avoid duplicate allowances. Payout must start after the first contribution year."
          }
        }
      }
    },
    "use_provider_statements_for_contribution_a86327" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimm Beiträge, Vertragswert, Zahlungsbeginn und Bruttorente aus den Anbieterunterlagen. Die Projektionen sind vor Einkommensteuer sowie Kranken- und Pflegeversicherungsbeiträgen. Zulagen, Steuerabzüge, Garantien, Rückkaufswerte und Anspruchsvoraussetzungen werden nicht automatisch ermittelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use provider statements for contributions, contract value, payment date and gross pension. Projections are before income tax, health and care contributions. Subsidies, tax deductions, guarantees, surrender values and eligibility are not inferred."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use provider statements for contributions, contract value, payment date and gross pension. Projections are before income tax, health and care contributions. Subsidies, tax deductions, guarantees, surrender values and eligibility are not inferred."
          }
        }
      }
    },
