    "we_send_an_ai_service_only_the_cleaned_m_84f40e" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir senden einem KI-Dienst nur den bereinigten Händlernamen (nie Beträge, Daten, IBANs, Notizen oder Personennamen) sowie Kategorien und deine Anweisungen, mit der Bitte, keine Daten zu speichern. Vorschläge werden nie automatisch angewendet. Du kannst dies jederzeit unter Einstellungen deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We send an AI service only the cleaned merchant name (never amounts, dates, IBANs, notes or personal names), along with categories and your instructions, requesting no data retention. Suggestions are never applied automatically. Disable it anytime in Settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviamo a un servizio di intelligenza artificiale solo il nome pulito dell'esercente (mai importi, date, IBAN, note o nomi di persone), insieme alle categorie e alle eventuali istruzioni personali, con richiesta di non conservare i dati. Le proposte non si applicano da sole. Puoi disattivarlo quando vuoi in Impostazioni."
          }
        }
      }
    },
