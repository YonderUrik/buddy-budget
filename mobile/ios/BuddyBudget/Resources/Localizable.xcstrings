    "avd_rules_start_in_2027_contributions_be_84b2ab" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die AVD-Regeln gelten ab 2027. Beiträge beginnen im gewählten Jahr; Zulagen werden zum Jahresende gutgeschrieben. Bestätige die Förderberechtigung und ordne Kinderzulagen nur einem Elternteil zu. Renditen sind Annahmen, keine Garantien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVD rules start in 2027. Contributions begin in the selected year; grants are credited at year-end. Confirm eligibility and allocate child allowances to one parent only. Returns are assumptions, not guarantees."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVD rules start in 2027. Contributions begin in the selected year; grants are credited at year-end. Confirm eligibility and allocate child allowances to one parent only. Returns are assumptions, not guarantees."
          }
        }
      }
    },
