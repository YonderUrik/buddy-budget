        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartenzahlungen, Überweisungen, Zinsen und Boni erscheinen unter Liquidität → Umsätze zum Kategorisieren. Der Saldo wird aus der vollständigen Historie ab null berechnet, da die Datei keinen offiziellen Saldo enthält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card payments, transfers, interest and bonuses go to Cash → Transactions, ready to categorise. The balance is calculated from the complete history starting at zero, as the file has no official balance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagamenti con carta, bonifici, interessi e bonus: finiscono in Liquidità → Movimenti, da categorizzare. Il saldo si calcola dallo storico completo partendo da zero, perché il file non contiene un saldo ufficiale."
          }
        }
      }
    },
