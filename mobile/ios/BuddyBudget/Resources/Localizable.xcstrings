    "average_daily_return_minus_that_of_a_ris_9962ce" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchschnittliche Tagesrendite abzüglich der eines risikofreien Kontos (der €STR-Zinssatz, nur für den Euro), geteilt durch die Standardabweichung und auf ein Jahr hochgerechnet. Unter 0 hast du weniger als ein Tagesgeldkonto erzielt, zwischen 0 und 0,5 wenig, zwischen 0,5 und 1 ordentlich, über 1 gut. Es werden mindestens %1$@ Tage an Daten benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average daily return minus that of a risk-free account (the €STR rate, euro only), divided by the standard deviation and annualised. Below 0 you earned less than a savings account, between 0 and 0.5 little, between 0.5 and 1 fair, above 1 well. At least %1$@ days of data are needed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendimento medio giornaliero meno quello di un conto senza rischio (il tasso €STR, solo per l'euro), diviso per la deviazione standard e portato a un anno. Sotto 0 hai reso meno di un conto deposito, tra 0 e 0,5 poco, tra 0,5 e 1 discreto, sopra 1 bene. Serve almeno %1$@ giorni di dati."
          }
        }
      }
    },
