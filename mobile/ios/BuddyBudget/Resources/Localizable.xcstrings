    "fund_costs_and_stamp_duty_their_long_ter_60bb70" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondskosten und italienische Stempelsteuer, ihre langfristige Wirkung und die Steuer bei einem vollständigen Verkauf heute. Fondskosten (TER) trägst du unter „Für Fortgeschrittene“ ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fund costs and stamp duty, their long-term impact, and the tax you would pay if you sold everything today. Enter fund costs (TER) under “For experts”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costi dei fondi e bollo, quanto erodono nel tempo e quanta imposta pagheresti vendendo tutto oggi. Il costo dei fondi (TER) lo inserisci tu in «Per esperti»."
          }
        }
      }
    },
    "fund_costs_ter_are_already_reflected_in_3bd882" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondskosten (TER) sind bereits im Kurs berücksichtigt: Sie werden nicht erneut abgezogen oder zu den erfassten Gebühren addiert. Nicht erfasste Brokerkosten sind nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fund costs (TER) are already reflected in the price: they are not deducted again or included in recorded fees. Any unrecorded broker costs are not included."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I costi del fondo (TER) sono già riflessi nel prezzo: non vengono sottratti di nuovo né inclusi tra le commissioni registrate. Eventuali costi del broker non registrati non sono inclusi."
          }
        }
      }
    },
