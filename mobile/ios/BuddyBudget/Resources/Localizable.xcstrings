    "move_one_row_or_column_small_changes_in_1d12d3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe eine Zeile oder Spalte weiter: Kleine Zeitänderungen bedeuten einen geringeren Einfluss. Ausgaben und Ersparnisse zählen meist mehr als Renditen und lassen sich direkt steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move one row or column: small changes in years mean that assumption has less impact. Spending and savings usually matter more than returns, and you control them directly."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muoviti di una riga o una colonna: se gli anni cambiano poco, quell'ipotesi pesa poco. Di solito spesa e risparmio contano molto più del rendimento, e sono anche le due che controlli tu."
          }
        }
      }
    },
    "move_the_slider_to_exclude_an_amount_it_0596ae" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Regler, um einen Betrag auszuschließen: Er ging auf dem Konto ein, ist aber kein echtes Einkommen (Erstattungen, Umbuchungen, Stornos)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the slider to exclude an amount: it entered the account but is not real income (refunds, internal transfers, reversals)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il cursore per escludere una parte dal conteggio: è entrata sul conto, ma non è reddito reale (rimborsi, giroconto, storni)."
          }
        }
      }
    },
    "move_the_slider_to_exclude_an_amount_it_56dde9" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Regler, um einen Betrag auszuschließen: Er ging vom Konto ab, ist aber keine Ausgabe (Erstattungen, Anteile anderer, Umbuchungen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the slider to exclude an amount: it left the account but is not an expense (refunds, other people's shares, internal transfers)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il cursore per escludere una parte dal conteggio: è uscita dal conto, ma non è una spesa (rimborsi, quote di altri, giroconto)."
          }
        }
      }
    },
    "move_the_slider_to_see_how_much_sooner_y_6135d1" : {
