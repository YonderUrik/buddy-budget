    "above_this_number_you_are_already_indepe_70d636" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oberhalb dieser Zahl bist du unter diesen Annahmen bereits unabhängig. Darunter zeigt der Balken die verbleibende Lücke. Wenige Zehntelprozentpunkte bei der Entnahmerate können das Ziel um Zehntausende Euro verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above this number, you are already independent under these assumptions. Below it, the bar shows the gap. A few tenths of a percentage point in the withdrawal rate can shift the target by tens of thousands of euros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopra il numero, con queste ipotesi sei già indipendente; sotto, la barra mostra quanto manca. Pochi decimi di tasso di prelievo spostano il traguardo di decine di migliaia di euro."
          }
        }
      }
    },
