    "maximum_cut_means_the_largest_spending_r_8bab86" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Maximale Kürzung“ ist die größte Ausgabensenkung gegenüber dem ersten Jahr. Höhere Kürzungen bedeuten größere Einschränkungen bei fallenden Märkten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Maximum cut” means the largest spending reduction relative to the first year. A higher cut means greater sacrifices when markets fall."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Taglio massimo» = di quanto la spesa scende, nel punto peggiore, rispetto a quella del primo anno. Più il taglio è alto, più la regola ti chiede sacrifici quando il mercato va male."
          }
        }
      }
    },
    "may_a4252f" : {
