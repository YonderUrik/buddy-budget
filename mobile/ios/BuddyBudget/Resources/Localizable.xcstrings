    "net_forecasts_use_the_tax_section_s_annu_4f8859" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoprognosen verwenden die jährlichen Pauschbeträge und Verluste aus dem Steuerbereich. Für ungeprüfte Steuerjahre oder unvollständige Steuerhistorien sind sie nicht verfügbar. Ausländische Quellensteuern und DBA-Anrechnungen werden nicht geschätzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net forecasts use the Tax section's annual allowances and losses. They are unavailable for unvalidated tax years or incomplete tax history. Foreign withholding and treaty credits are not estimated."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net forecasts use the Tax section's annual allowances and losses. They are unavailable for unvalidated tax years or incomplete tax history. Foreign withholding and treaty credits are not estimated."
          }
        }
      }
    },
