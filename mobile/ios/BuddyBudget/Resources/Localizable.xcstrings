    "an_index_starts_at_1_and_follows_daily_r_243ce9" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Index beginnt bei 1 und folgt täglichen Renditen ohne Einzahlungseffekte. Der größte Verlust ist der stärkste Rückgang von einem Hoch zum folgenden Tief. Die Erholung markiert die erneute Rückkehr zum Hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An index starts at 1 and follows daily returns, excluding the effect of deposits. The worst loss is the largest drop from a peak to the following low; recovery marks the date the index reaches that peak again."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si costruisce un indice che parte da 1 e segue i rendimenti giornalieri (così i versamenti non lo fanno salire). La perdita peggiore è la distanza massima da un picco al punto più basso successivo; «tornato al massimo» è il giorno in cui l'indice rivede quel picco."
          }
        }
      }
    },
