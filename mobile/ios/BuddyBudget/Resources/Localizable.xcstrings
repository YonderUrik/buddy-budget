    "a_trip_a_home_deposit_a_fund_for_the_une_f71cc2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Reise, die Anzahlung für eine Wohnung, ein Notgroschen: wähle, wie viel du brauchst und woher das Geld kommt (Konten oder Anlagen). Wir sagen dir, wann du es erreichst, ob deine Ersparnis für alles reicht und um wie viel jedes Sparziel den Tag verschiebt, an dem du aufhören kannst zu arbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trip, a home deposit, a fund for the unexpected: choose how much you need and where the money comes from (accounts or investments). We tell you when you get there, whether your savings cover everything and how much each goal moves the day you can stop working."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viaggio, l'anticipo di casa, un fondo per gli imprevisti: scegli quanto ti serve e da dove arrivano i soldi (conti o investimenti). Ti diciamo quando ci arrivi, se il risparmio basta per tutto e di quanto ogni obiettivo sposta il giorno in cui puoi smettere di lavorare."
          }
        }
      }
    },
