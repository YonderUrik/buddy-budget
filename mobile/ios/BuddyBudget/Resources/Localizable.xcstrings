          }
        }
      }
    },
    "sortino_looks_only_at_downward_swings_hi_2749f0" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino betrachtet nur Abwärtsschwankungen (höher ist besser). Calmar vergleicht die Jahresrendite mit dem stärksten Rückgang. VaR ist die Verlustschwelle an einem schlechten Tag, CVaR der durchschnittliche Verlust darüber hinaus. Der Risikobeitrag zeigt, ob eine Position stärker zum Risiko als zum Wert beiträgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino looks only at downward swings (higher is better). Calmar compares annual returns with the worst decline. VaR is the loss threshold on a bad day; CVaR is the average loss beyond it. Risk contribution shows whether a position contributes more to risk than to value."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino guarda solo le oscillazioni verso il basso (più alto è meglio). Calmar confronta il rendimento annuo con il peggior calo. VaR e CVaR dicono quanto si perde in un giorno brutto: il VaR è la soglia, il CVaR la perdita media oltre la soglia. Il contributo al rischio mostra se una posizione pesa sul rischio più di quanto pesi sul valore."
          }
        }
      }
    },
    "sortino_price_1994_performance_measureme_f0343a" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino & Price (1994), «Performance Measurement in a Downside Risk Framework», Journal of Investing"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino & Price (1994), «Performance Measurement in a Downside Risk Framework», Journal of Investing"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino & Price (1994), «Performance Measurement in a Downside Risk Framework», Journal of Investing"
          }
        }
