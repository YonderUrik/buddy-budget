        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We create a dedicated account (and portfolio if needed) with a zero opening balance: upload the full history or adjust the balance after import. New securities use manual prices."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creo un conto dedicato (e un portafoglio, se serve) con saldo di partenza zero: carica lo storico completo oppure correggi il saldo dopo l'import. Gli strumenti nuovi avranno prezzi manuali."
          }
        }
      }
    },
