    "you_enter_ter_yourself_missing_entries_m_7e8ce5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die TER gibst du selbst ein; fehlende Angaben machen die angezeigten Kosten zum Mindestwert. Handelsgebühren und nicht ausgewiesene interne Kosten wie Spreads oder Tracking-Differenzen fehlen. Die italienische Stempelsteuer gilt für italienische Wertpapierdepots; andere Regelungen können abweichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You enter TER yourself; missing entries make shown costs a minimum. Trading fees and undisclosed internal costs such as spreads and tracking differences are excluded. Italian stamp duty applies to Italian securities accounts; other regimes may differ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il TER lo inserisci tu: se manca, il costo mostrato è un minimo. Non include commissioni di acquisto/vendita né costi interni non dichiarati (spread, tracking difference). Il bollo vale per chi ha un deposito titoli in Italia; con altri regimi può non applicarsi."
          }
        }
      }
    },
