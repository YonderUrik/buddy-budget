    "zero_data_retention_data_goes_through_op_dbccf4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Data Retention: Die Daten gehen über OpenRouter nur an Anbieter, die nach der Antwort nichts speichern und sie nicht zum Training nutzen. Ist keiner verfügbar, wird die Anfrage nicht gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero data retention: data goes through OpenRouter only to providers that keep nothing after the answer and don't use it for training. If none is available, the request doesn't go out."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero data retention: i dati passano da OpenRouter solo verso fornitori che non li conservano dopo la risposta e non li usano per l'addestramento. Se nessuno è disponibile, la richiesta non parte."
          }
        }
      }
    },
