    "each_year_provides_what_you_need_2d5e35" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pro Jahr erhältst du den benötigten Betrag."
          }
        },
        "en" : {
          "stringUnit" : {
