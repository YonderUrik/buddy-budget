    "the_remainder_is_an_estimate_by_subtract_c9b633" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rest ist eine Differenzschätzung, keine direkte Renditemessung; nutze dafür die Wertentwicklung der Anlagen. Der Liquiditätsverlauf wird einmal rekonstruiert. Später hinzugefügte Konten oder neu erfasste Anlagen erscheinen bei Aufnahme als Marktsprung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remainder is an estimate by subtraction, not a direct return measure; use Investment Performance for that. Cash history is reconstructed once. Late-added accounts or newly recorded investments appear as a market jump when first included."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il resto è una stima per differenza, non una misura diretta del rendimento (per quello c'è la scheda Rendimenti degli Investimenti). Lo storico della liquidità è ricostruito una volta sola: un conto aggiunto tardi, o investimenti registrati da poco, compaiono come un salto «da mercato» nel mese in cui entrano."
          }
        }
      }
    },
    "the_remaining_0_comes_from_markets_and_o_13f8d3" : {
