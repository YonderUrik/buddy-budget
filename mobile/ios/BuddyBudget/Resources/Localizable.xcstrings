    "the_standard_deviation_of_daily_returns_c4ddc4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardabweichung der täglichen Renditen, annualisiert mit der Wurzel aus etwa 252 Handelstagen. ± zeigt die übliche Bandbreite: In etwa zwei von drei Jahren liegt der Wert darin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The standard deviation of daily returns, annualised using the square root of roughly 252 trading days. The ± indicates the usual range: values stay within it in about two years out of three."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È la deviazione standard dei rendimenti giornalieri, portata a un anno moltiplicandola per la radice dei giorni di borsa in un anno (circa 252). Il ± dice quanto ci si muove di solito: in circa due anni su tre il valore resta dentro quell'intervallo."
          }
        }
      }
    },
