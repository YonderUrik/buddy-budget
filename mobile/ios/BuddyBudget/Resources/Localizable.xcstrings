          "stringUnit" : {
            "state" : "translated",
            "value" : "Your consent to read your %1$@ accounts expires **soon**. Renewing it takes a minute. If you don't, your data stays in BuddyBudget but balances and transactions stop updating."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il consenso a leggere i tuoi conti di %1$@ scade **a breve**. Rinnovarlo richiede un minuto. Se non lo fai, i dati restano in BuddyBudget ma saldi e movimenti smettono di aggiornarsi."
          }
        }
      }
    },
