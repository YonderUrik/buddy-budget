      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jahresrendite unter Berücksichtigung der Einzahlungszeitpunkte: Geld vom letzten Monat hatte weniger Zeit, Rendite zu erzielen. Bei fehlendem frühem Verlauf wird geschätzt."
