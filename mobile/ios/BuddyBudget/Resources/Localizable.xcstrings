    "here_s_where_your_goals_stand_at_the_sta_41052f" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So stehen deine Sparziele zum Monatsanfang. Deine Ersparnisse reichen nicht für alle Anteile: Es fehlen **%1$@** im Monat. Wenn du für ein Ziel Geld auf ein Konto überwiesen oder Wertpapiere gekauft hast, aktualisiere, wie viel du zurückgelegt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here's where your goals stand at the start of the month. Your savings don't cover every share: **%1$@** a month is missing. If you moved money to an account or bought securities for a goal, update how much you've set aside."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecco a che punto sono i tuoi obiettivi a inizio mese. Il risparmio non basta per tutte le quote: ne mancano **%1$@** al mese. Se hai spostato soldi su un conto o comprato titoli per un obiettivo, aggiorna quanto hai messo da parte."
          }
        }
      }
    },
