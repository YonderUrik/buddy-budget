    "uses_actual_daily_portfolio_returns_in_t_9fa4e6" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet tatsächliche tägliche Portfoliorenditen im verfügbaren Zeitraum. Historischer VaR/CVaR betrachtet die schlechtesten 5 %% der Tage. Risikobeiträge werden per Euler-Zerlegung der Kovarianzmatrix der Hauptpositionen berechnet und ergeben zusammen 100 %%. Konzentration: Herfindahl-Index (Summe quadrierter Gewichte); effektive Positionen = 1 ÷ Index."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses actual daily portfolio returns in the available period. Historical VaR/CVaR examine the worst 5%% of days. Risk contributions use Euler decomposition of the main positions' covariance matrix and sum to 100%%. Concentration uses the Herfindahl index (sum of squared weights); effective positions = 1 ÷ index."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si usano i rendimenti giornalieri reali del tuo portafoglio nel periodo con dati. VaR/CVaR storici: il 5%% dei giorni peggiori. Contributo al rischio: scomposizione di Eulero sulla matrice di covarianza (le quote sommano al 100%%) tra le posizioni principali. Concentrazione: indice di Herfindahl (somma dei pesi al quadrato) e numero effettivo di posizioni = 1 ÷ indice."
          }
        }
      }
    },
