    "your_target_is_the_wealth_that_lets_you_7a65a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ziel ist das Vermögen, von dem du leben kannst: Jedes Jahr entnimmst du einen kleinen Teil für deine Ausgaben. Du brauchst nur eine Zahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your target is the wealth that lets you live off your savings: you withdraw a small part each year to cover your expenses. You only need one figure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traguardo è il patrimonio che ti permette di vivere dei tuoi soldi: ogni anno ne prelevi una piccola parte e ti basta per le spese. Ti serve una sola cifra."
          }
        }
      }
    },
