      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Vermögensanteil mit Ober- und Untergrenzen für jährliche Änderungen (ungefähr ±5 %%). Die Ausgaben bleiben stabiler als bei einer rein prozentualen Regel."
          }
