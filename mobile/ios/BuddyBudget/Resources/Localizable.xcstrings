      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was bringt eine einmalige Sonderzahlung? Sieh dir die Zinsersparnis an und vergleiche eine niedrigere Rate mit kürzerer Laufzeit. Bereits geleistete Zahlungen kannst du hier erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if you made a one-off extra payment? See the interest saved and compare reducing the instalment or term. You can also record a payment already made."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E se versassi una somma in più, una volta? Vedi quanto risparmi di interessi e se ti conviene ridurre la rata o la durata. Se l'hai già fatto, da qui puoi anche registrarla."
          }
        }
      }
    },
