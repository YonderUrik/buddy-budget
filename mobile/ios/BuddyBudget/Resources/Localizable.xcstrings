        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Löschen“ entfernt die durch diese Datei erzeugten Buchungen und Salden. Vor der Bestätigung siehst du, was entfernt wird; du kannst die Datei jederzeit erneut importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Delete” removes the transactions and balances introduced by that file. You will see what is removed before confirming, and can always reimport the file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Elimina» toglie le operazioni e i saldi che quel file aveva portato; ti mostro cosa sparisce prima di confermare e puoi sempre reimportare il file."
          }
        }
