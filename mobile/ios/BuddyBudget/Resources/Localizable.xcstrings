        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Indexvergleich zählen nur Tage mit beiden Kursen. Die Korrelation (−1 bis 1) zeigt gemeinsame Bewegungen; Beta misst die Portfoliobewegung je 1 %% Indexänderung."
          }
        },
