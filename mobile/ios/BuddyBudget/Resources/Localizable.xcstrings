    "this_is_not_a_promise_but_a_measure_of_y_962f24" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine Zusage, sondern ein Maß für deinen Spielraum. Über 90 %% ist robust; bei 75–90 %% können in ungünstigen Fällen Kürzungen nötig sein; unter 75 %% ist das Ergebnis fragil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a promise, but a measure of your margin. Above 90%% is robust; 75–90%% may need spending cuts in unlucky scenarios; below 75%% is fragile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è una promessa: dice quanto margine hai. Sopra il 90%% è solida, fra 75%% e 90%% regge ma con tagli nei casi sfortunati, sotto il 75%% è fragile."
          }
        }
      }
    },
