    "simplified_estimate_excluding_loss_pools_415740" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereinfachte Schätzung ohne Verlusttöpfe, Verrechnung zwischen Positionen oder Verkäufe in unterschiedlichen Jahren. Eine zeitliche Aufteilung kann die Steuer ändern. Es gelten die italienischen Regeln aus Anlagen → Steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplified estimate excluding loss pools, offsets between positions and selling in different years. Spreading sales can change taxes. Uses the Italian rules already applied in Investments → Taxes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima semplificata: non considera lo zaino fiscale, la compensazione tra posizioni, né il fatto che venderesti in anni diversi (frazionando le vendite si può pagare diversamente). Le regole fiscali sono quelle già usate nella scheda Tasse degli Investimenti."
          }
        }
      }
    },
    "simplified_estimate_using_standard_rates_945b79" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereinfachte Schätzung mit Standardsätzen: ohne Verrechnung früherer Verluste und ohne Sonderfälle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplified estimate using standard rates: excludes offsets with past losses and special cases."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima semplificata con le aliquote standard: non considera compensazioni con minusvalenze pregresse né casi particolari."
          }
        }
      }
    },
