    "when_the_app_is_fairly_sure_it_assigns_t_07575d" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die App ziemlich sicher ist, ordnet sie die Kategorie automatisch zu. Hier wählst du die übrigen und prüfst bereits zugeordnete Kategorien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the app is fairly sure, it assigns the category automatically. Here you choose the others and review those already assigned."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è abbastanza sicura l&apos;app mette la categoria da sola: qui scegli le altre e controlli quelle già messe."
          }
        }
      }
    },
