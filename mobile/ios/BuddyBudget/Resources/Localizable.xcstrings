    "future_amounts_use_today_s_purchasing_po_9085fa" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Künftige Beträge werden in heutiger Kaufkraft ausgedrückt: 100.000 € in 30 Jahren entsprechen dem, was 100.000 € heute kaufen. So sind sie vergleichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future amounts use today's purchasing power: €100,000 in 30 years represents what €100,000 buys today, making comparisons meaningful."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli importi futuri sono espressi con il potere d'acquisto di oggi: 100.000 € tra 30 anni valgono quanto ciò che oggi comprano 100.000 €. Così il confronto è onesto."
          }
        }
      }
    },
    "future_net_amounts_are_scenarios_using_u_209822" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zukünftige Nettobeträge sind Szenarien mit unveränderten Regeln von 2026, keine geprüften Steuerberechnungen für zukünftige Jahre. Im Januar wird der Freibetrag erneuert; prognostizierte Verluste werden vorgetragen. Für das zukünftige Jahr werden keine externen Einkünfte, ausländischen Steuergutschriften oder neuen Vorabpauschalen angenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future net amounts are scenarios using unchanged 2026 rules, not validated future tax assessments. Each January the allowance resets and projected losses carry forward. No external income, foreign tax credits or new fund advances are assumed for the future year."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future net amounts are scenarios using unchanged 2026 rules, not validated future tax assessments. Each January the allowance resets and projected losses carry forward. No external income, foreign tax credits or new fund advances are assumed for the future year."
          }
        }
      }
    },
    "future_spending_may_differ_because_of_ch_b5cbfa" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Künftige Ausgaben können sich durch Kinder, Wohnen oder Gesundheit ändern. Entnahmesätze sind keine Garantie, sondern beschreiben historische Ergebnisse. Künftige Renditen sind ungewiss, deshalb gibt es die Simulation. Schulden werden von diesem Vermögenswert nicht abgezogen: Hypothekenraten sind bereits in den Ausgaben enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future spending may differ because of children, housing or health. Withdrawal rates are not guarantees; they describe historical outcomes. Future returns are uncertain, hence Simulation. Debts are not deducted from this wealth measure: mortgage payments are already included in spending."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La spesa di oggi non è per forza quella futura (figli, casa, salute). Il tasso di prelievo non è una garanzia: descrive cosa sarebbe successo nel passato. Il rendimento futuro è incerto: per questo esiste la scheda Simulazione. Il patrimonio non sottrae i debiti: se hai un mutuo, le sue rate sono già dentro la spesa."
          }
        }
      }
    },
