      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Konten ohne Anmeldung seit %2$@ Tagen werden gelöscht. Wenn du dich nicht **innerhalb von %3$@ Tagen** anmeldest, werden dein Konto und alle deine Daten endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: accounts with no sign-in for %2$@ days are deleted. If you don't sign in **within %3$@ days**, your account and all your data will be permanently deleted."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: gli account senza accessi da %2$@ giorni vengono eliminati. Se non accedi entro il **tra %3$@ giorni**, l'account e tutti i tuoi dati verranno eliminati definitivamente."
          }
        }
      }
    },
