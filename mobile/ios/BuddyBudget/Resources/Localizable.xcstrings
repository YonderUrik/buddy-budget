          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il risultato cambia moltissimo spostando un'ipotesi di poco, fidati meno del numero: dipende troppo da quell'ipotesi."
          }
        }
      }
    },
    "if_it_appears_in_your_transactions_we_wi_3144b4" : {
