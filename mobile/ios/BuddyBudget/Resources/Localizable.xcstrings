    "with_less_than_a_year_of_data_figures_ar_61cc3c" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei weniger als einem Jahr Daten sind die Werte nur Richtwerte. Die Historie enthält keine Krisen, die dieses Portfolio nicht erlebt hat. Täglicher VaR und CVaR beschreiben keine langsamen, anhaltenden Rückgänge."
