    "does_not_use_ai_on_its_own_your_rules_al_7feaea" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt KI nicht von sich aus. Deine Regeln gelten immer. Ist diese Option aktiv, ordnet die App auch Kategorien mit mindestens %1$@ %% Sicherheit zu, anhand deiner bisherigen Auswahl oder des aktivierten Assistenten. Unter „Kategorisieren“ → „Von der App zugeordnet“ kannst du sie prüfen und ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does not use AI on its own. Your rules always apply. When enabled, the app also assigns categories it is fairly sure about (at least %1$@%% confidence, based on your past choices or the assistant if enabled). Review and change them in Categorize → “Assigned by the app”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non usa l'AI da sola. Le tue regole valgono sempre. Se attivo, l'app mette da sola anche le categorie di cui è abbastanza sicura (almeno al %1$@%%, dalle tue scelte passate o, se lo hai attivato, dall'assistente). Le ritrovi in Categorizza → «Messe dall'app», dove puoi cambiarle."
          }
        }
      }
    },
