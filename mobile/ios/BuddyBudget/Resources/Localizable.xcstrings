    "if_you_do_not_need_a_few_lines_import_th_b5365b" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein paar Zeilen nicht brauchst, importiere die anderen: Übersprungene Zeilen gehen nicht in deine Konten ein, und du kannst sie von Hand hinzufügen oder korrigiert hochladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you do not need a few lines, import the others: skipped lines do not enter your accounts and you can add them by hand or upload them corrected."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se poche righe non ti servono, importa le altre: le righe saltate non entrano nei conti e potrai aggiungerle a mano o ricaricarle corrette."
          }
        }
      }
    },
    "if_you_exceed_the_amount_for_your_chosen_537d11" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du den Betrag für deinen gewählten Zeitraum übersteigst, kannst du auf weitere Rücklagen verzichten und nur laufende Ausgaben decken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you exceed the amount for your chosen horizon, you can stop saving for the future and cover only current expenses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se superi la cifra dell'orizzonte che ti interessa, puoi smettere di accantonare per il futuro e coprire solo le spese correnti."
          }
        }
      }
    },
    "if_you_retire_early_your_statutory_pensi_753703" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei frühem Ruhestand beginnt die gesetzliche Rente später und senkt ab dann deine Entnahmen. Gib den Betrag in heutigen Euro und die Jahre bis zum Rentenbeginn ab Ruhestandsstart ein; lasse es für eine vorsichtige Planung leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you retire early, your statutory pension starts later and reduces withdrawals from then on. Enter the amount in today's euros and years after retirement when it starts; leave blank to exclude it (a cautious choice)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se andrai in pensione presto, la pensione pubblica arriverà più tardi e ridurrà quanto devi prelevare da allora. Scrivi l'importo in euro di oggi e fra quanti anni dall'inizio la riceverai; lascia vuoto per ignorarla (scelta prudente)."
          }
        }
      }
    },
