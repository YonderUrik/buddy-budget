    "this_projection_applies_the_2026_tax_tar_070112" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Prognose verwendet den Steuertarif und die Versicherungsgrenzen 2026 unverändert für zukünftige Jahre. Der Besteuerungsanteil richtet sich nach dem Rentenbeginn. Erfasse die Renten einer versicherten Person; bei Zusammenveranlagung wird das gemeinsame sonstige zu versteuernde Einkommen verwendet. Freiwillige gesetzliche Versicherung und besondere betriebliche Versorgungswege erfordern eine individuelle Berechnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This projection applies the 2026 tax tariff and insurance thresholds unchanged to future years. Pension taxable shares follow the start-year schedule. Enter pensions for one insured person; joint assessment uses combined other taxable income. Voluntary statutory insurance and special occupational arrangements require an individual calculation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This projection applies the 2026 tax tariff and insurance thresholds unchanged to future years. Pension taxable shares follow the start-year schedule. Enter pensions for one insured person; joint assessment uses combined other taxable income. Voluntary statutory insurance and special occupational arrangements require an individual calculation."
          }
        }
      }
    },
