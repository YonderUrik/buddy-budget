    "a_fund_or_etf_s_annual_cost_as_a_percent_eb42b9" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jährliche Fonds- oder ETF-Kosten als Wertanteil, bereits von der Rendite abgezogen. Sie stehen im Basisinformationsblatt. Globale ETFs kosten häufig 0,1–0,4 %%; kleine jährliche Beträge wirken langfristig stark."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fund or ETF's annual cost as a percentage of value, already deducted from returns. Find it in the KID. Global ETFs commonly charge 0.1–0.4%%; small yearly amounts matter over long periods."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il costo annuo di un fondo o ETF, in %% del valore, già tolto dal rendimento. Lo trovi nel KID. Un ETF globale è di solito 0,1-0,4%%. Piccolo ogni anno, pesa su orizzonti lunghi."
          }
        }
      }
    },
