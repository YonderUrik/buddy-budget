    "voluntary_insurance_includes_private_pen_d9f6d2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die freiwillige Versicherung berücksichtigt private Renten und weitere beitragspflichtige Einkünfte mit Mindest- und Höchstgrenzen 2026 und ohne Betriebsrentenfreibetrag. Erfasse beitragspflichtige Miet- und Kapitaleinkünfte, nicht die gesamten Entnahmen. Private Kapitalauszahlungen, Beschäftigung, Ehegatteneinkommen und besondere Einkunftsarten benötigen eine Berechnung der Krankenkasse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voluntary insurance includes private pensions and other assessed income, with 2026 minimum and maximum bases and no occupational exemption. Enter assessed rental and capital income, not total withdrawals. Private lump sums, employment, spouse-income attribution and special income types need an insurer calculation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voluntary insurance includes private pensions and other assessed income, with 2026 minimum and maximum bases and no occupational exemption. Enter assessed rental and capital income, not total withdrawals. Private lump sums, employment, spouse-income attribution and special income types need an insurer calculation."
