    "if_the_reason_mentions_a_date_or_an_amou_1ff68b" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Grund ein Datum oder einen Betrag nennt, prüfe, ob sie in der Datei wie in den anderen Zeilen geschrieben sind (gleiches Dezimaltrennzeichen, gleiche Datumsform)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the reason mentions a date or an amount, check that they are written in the file like in the other lines (same decimal separator, same date form)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il motivo parla di data o importo, controlla che nel file siano scritti come nelle altre righe (stesso separatore decimale, stessa forma della data)."
