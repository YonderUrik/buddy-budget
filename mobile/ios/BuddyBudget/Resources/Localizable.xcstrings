    "occasionally_enter_the_two_figures_from_6b1126" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage gelegentlich die beiden Werte deines Vorsorgeanbieters ein: Nettoeinzahlungen und Marktwert. Wir berechnen Renditen, mögliche Nettoauszahlungen, den Vergleich mit TFR beim Arbeitgeber und Prognosen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occasionally enter the two figures from your pension provider: net contributions and market value. We calculate returns, potential net withdrawals, comparison with company-held TFR and projections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti basta inserire, ogni tanto, i due numeri che vedi nell'area clienti del fondo: contributi netti e controvalore. Da lì calcoliamo rendimento, quanto ti resterebbe prelevando oggi, il confronto col TFR in azienda e dove arriverai."
          }
        }
      }
    },
