        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annual fluctuations in value. 12%% means the portfolio typically moves up or down by around 12 percentage points from the average; higher volatility means a bumpier path."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto il valore oscilla in un anno. Il 12%% significa che di solito il portafoglio sale o scende fino a 12 punti rispetto alla media; più è alta, più il percorso è ballerino."
          }
        }
      }
    },
