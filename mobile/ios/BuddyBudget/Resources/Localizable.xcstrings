          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni anno prelevi una percentuale di ciò che hai in quel momento. Il patrimonio non si esaurisce mai, ma la spesa sale e scende con il mercato."
          }
        }
      }
    },
