    "a_lower_rate_is_more_cautious_and_requir_d7d9fa" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein niedrigerer Satz ist vorsichtiger und benötigt mehr Kapital. Ein höherer Satz braucht weniger Kapital, hält aber in schlechten Marktphasen weniger lange. 3,5 %% ist eine vorsichtige Annahme; die klassischen 4 %% stammen aus US-Studien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lower rate is more cautious and requires more capital. A higher rate needs less capital but lasts less well in bad markets. 3.5%% is a cautious assumption; the classic 4%% comes from US studies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tasso più basso è più prudente (serve più capitale), uno più alto richiede meno capitale ma dura meno nei periodi cattivi. Il 3,5%% è un valore prudente; il classico 4%% viene dagli studi americani."
          }
        }
      }
    },
    "a_manual_account_is_enough_name_and_toda_417a99" : {
