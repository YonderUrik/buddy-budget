    "analytics_is_where_you_explore_your_numb_8d19d8" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den Analysen von Buddy Budget erkundest du deine Zahlen. Oben siehst du das geschätzte Jahr deiner finanziellen Unabhängigkeit und vier Regler für Was-wäre-wenn-Szenarien. Darunter beantworten vier Karten jeweils eine Frage mit einem Satz und einem Diagramm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analytics is where you explore your numbers in Buddy Budget. At the top are your estimated retirement year and four sliders for “what if” scenarios. Below, four cards each answer a question with a sentence and a chart."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analitiche è la parte di Buddy Budget per chi vuole ragionare sui numeri. In alto vedi l'anno in cui puoi smettere di lavorare e quattro cursori per provare «e se…»; sotto, quattro schede rispondono ciascuna a una domanda con una frase e un grafico."
          }
        }
      }
    },
