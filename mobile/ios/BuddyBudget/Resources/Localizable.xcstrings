    "when_on_the_cleaned_up_merchant_name_nev_bc3ee4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiv, wird der bereinigte Händlername (nie Beträge, Daten, IBANs, Notizen oder Personennamen) zusammen mit deinen Kategorien und eventuellen Anweisungen an OpenRouter gesendet, nur an Anbieter, die keine Daten speichern (Zero Data Retention). Du kannst jederzeit widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the cleaned-up merchant name (never amounts, dates, IBANs, notes or people's names) is sent to OpenRouter together with your categories and any instructions you add, only to providers that keep no data (zero data retention). You can withdraw at any time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, il nome pulito dell'esercente (mai importi, date, IBAN, note o nomi di persone) viene inviato a OpenRouter insieme alle categorie e alle tue eventuali istruzioni, solo verso fornitori che non conservano i dati (zero data retention). Puoi revocare in ogni momento."
          }
        }
      }
    },
