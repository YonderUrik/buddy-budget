    "each_account_or_security_can_appear_only_111f25" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Konto oder Wertpapier darf nur einmal vorkommen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each account or security can appear only once"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni conto o titolo può comparire una volta sola"
          }
        }
      }
    },
    "each_bar_is_one_month_blue_is_savings_te_accf8b" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Balken steht für einen Monat: Blau zeigt Ersparnisse, Türkis Märkte und sonstige Faktoren. Bei fallenden Märkten können Balken unter null liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each bar is one month: blue is savings, teal is markets and other factors. Bars may fall below zero when markets decline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni barra è un mese: in blu la parte dal risparmio, in verde acqua la parte da mercato e altro. Le barre possono andare sotto lo zero quando il mercato scende."
          }
        }
      }
    },
    "each_category_except_uncategorised_will_b2a5d6" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Kategorie (außer „Unkategorisiert“) erhält eine andere Farbe. Manuell zugewiesene Farben werden überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each category (except “Uncategorised”) will receive a different colour. Manually assigned colours will be overwritten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni categoria (esclusa \"Da categorizzare\") riceverà un colore diverso dalle altre. I colori attualmente assegnati manualmente verranno sovrascritti."
          }
        }
      }
    },
    "each_cell_is_a_combination_compare_years_d7a794" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zelle ist eine Kombination. Vergleiche die Jahre zwischen Zeilen und Spalten: Kleine Änderungen bedeuten geringen Einfluss dieser Annahme. Ausgaben und Ersparnisse wirken meist deutlich stärker als die Rendite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each cell is a combination. Compare years across rows and columns: small changes mean that assumption has little impact. Spending and savings usually matter far more than returns."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cella è una combinazione. Guarda quanto cambiano gli anni spostandoti di una riga o di una colonna: se cambiano poco, quell'ipotesi pesa poco. Di solito spesa e risparmio pesano molto più del rendimento."
          }
        }
      }
    },
    "each_cell_recalculates_years_using_the_f_28becb" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zelle berechnet die Jahre mit der FIRE-Formel neu. In der Ausgaben-/Spar-Tabelle senken geringere Ausgaben das Ziel und schaffen zusätzliche Ersparnisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each cell recalculates years using the FIRE formula. In the spending/savings table, lower spending both reduces the target and frees up savings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cella ricalcola gli anni al traguardo con la stessa formula del numero FIRE. Nella tabella spesa/risparmio, spendere meno abbassa il traguardo e libera anche risparmio."
          }
        }
      }
    },
    "each_charge_is_added_back_to_the_portfol_9c9fef" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Gebühr fließt am Zahlungstag rechnerisch ins Portfolio zurück und erzielt dieselbe Rendite. Deine Buchungen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each charge is added back to the portfolio on its payment date and earns the same return. Your transactions stay unchanged."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni importo pagato torna nel portafoglio il giorno in cui l'hai versato e rende come il resto. Non cambia le tue operazioni."
          }
        }
      }
    },
    "each_file_must_be_smaller_than_5_mb_ed5661" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
