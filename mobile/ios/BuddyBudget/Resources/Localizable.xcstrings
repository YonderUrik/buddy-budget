    "if_a_small_assumption_change_greatly_alt_fc7317" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine kleine Änderung das Ergebnis stark beeinflusst, vertraue der Zahl weniger: Sie hängt zu sehr von dieser Annahme ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a small assumption change greatly alters the result, trust the figure less: it depends too heavily on that assumption."
