    "suggestions_are_never_applied_automatica_509e87" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschläge werden nie automatisch angewendet: Du bestätigst jede Karte. Eine Auswahl wird nur auf deinen Wunsch zur Regel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions are never applied automatically: you confirm each card. A choice becomes a rule only if you ask."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le proposte non si applicano mai da sole: le confermi tu, una carta alla volta. Una scelta diventa una regola solo se lo chiedi."
          }
        }
      }
    },
