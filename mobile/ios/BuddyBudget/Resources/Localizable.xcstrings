    "ask_whether_you_could_cut_spending_by_th_60e129" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überlege, ob du deine Ausgaben so stark senken könntest. Falls nicht, passt die auf dem Papier beste Regel vielleicht nicht zu dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask whether you could cut spending by that much. If not, the best rule on paper may not suit you."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiediti se sapresti ridurre le spese di quella misura: se no, la regola migliore sulla carta non è la tua."
          }
        }
      }
    },
