    "we_create_a_dedicated_account_and_portfo_e0de15" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erstellen ein eigenes Konto (und bei Bedarf ein Portfolio) mit Anfangssaldo null: Lade die vollständige Historie hoch oder passe den Saldo nach dem Import an. Neue Wertpapiere verwenden manuelle Kurse."
