    "adjusts_the_time_weighted_return_for_pri_5cd6a8" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereinigt die zeitgewichtete Rendite um Preissteigerungen in Italien (Eurostat-Index). Ein positiver Wert bedeutet höhere Kaufkraft. Die Schätzung verwendet den zuletzt verfügbaren monatlichen Inflationswert, dessen Datum unter der Zahl steht. Sie entspricht nicht der Diagrammlinie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjusts the time-weighted return for price increases in Italy (Eurostat index). A positive value indicates increased purchasing power. This estimate uses the latest available monthly inflation figure, dated below the number. It is not the chart line."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregge il rendimento TWR per l’aumento dei prezzi in Italia (indice Eurostat). Un valore positivo indica un aumento del potere d’acquisto. È una stima che usa l’ultimo dato mensile di inflazione disponibile: la data è indicata sotto il numero. Non è la linea del grafico."
          }
        }
      }
    },
    "adjusts_twr_for_rising_prices_in_your_pr_f124e5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereinigt die TWR um den Preisanstieg im Produktland (%1$@, Eurostat-Index). Ein positiver Wert bedeutet einen Kaufkraftgewinn. Die Schätzung verwendet den letzten verfügbaren monatlichen Inflationswert; dessen Datum steht unter dem Ergebnis. Dies ist nicht die Linie im Diagramm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjusts TWR for rising prices in your product country (%1$@, Eurostat index). A positive value indicates increased purchasing power. This estimate uses the latest available monthly inflation figure; its date appears below the value. It is not the chart line."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregge il rendimento TWR per l’aumento dei prezzi nel paese del prodotto (%1$@, indice Eurostat). Un valore positivo indica un aumento del potere d’acquisto. È una stima che usa l’ultimo dato mensile di inflazione disponibile: la data è indicata sotto il numero. Non è la linea del grafico."
          }
        }
      }
    },
