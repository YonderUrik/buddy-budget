    "gross_forecasts_repeat_historical_divide_2e8281" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bruttoprognose wiederholt historische Dividenden für aktuelle Bestände oder verwendet erfasste Anleihebedingungen. Zahlungen und Wechselkurse können sich ändern. Fehlende Historie bedeutet nicht, dass keine Erträge zu erwarten sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gross forecasts repeat historical dividends for current holdings or use recorded bond terms. Payments and exchange rates can change. Missing history is not a forecast of zero income."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gross forecasts repeat historical dividends for current holdings or use recorded bond terms. Payments and exchange rates can change. Missing history is not a forecast of zero income."
          }
        }
      }
    },
