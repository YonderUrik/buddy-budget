    "assessment_and_church_tax_settings_come_212ef2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veranlagung und Kirchensteuer stammen aus Steuern. Die Kirchensteuer wird vor ihrem Sonderausgabenabzug geschätzt; persönliche Freibeträge müssen in den Einkommensannahmen berücksichtigt werden. Renteneinkünfte werden gemeinsam besteuert, mit einem Werbungskosten-Pauschbetrag und einem Krankenversicherungsfreibetrag für Betriebsrenten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assessment and church-tax settings come from Taxes. Church tax is estimated before its special-expense deduction; child tax allowances and other personal relief must be included in your income assumptions. Pension income is taxed together, with one expense allowance and one occupational health exemption."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assessment and church-tax settings come from Taxes. Church tax is estimated before its special-expense deduction; child tax allowances and other personal relief must be included in your income assumptions. Pension income is taxed together, with one expense allowance and one occupational health exemption."
          }
        }
      }
    },
    "assessment_and_church_tax_settings_come_84fe91" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veranlagung und Kirchensteuer stammen aus Steuern. Die Kirchensteuer wird vor ihrem Sonderausgabenabzug geschätzt. Hier erfasste Kinderfreibeträge beeinflussen nur die Zuschlagsberechnung. Renteneinkünfte werden gemeinsam besteuert, mit einem Werbungskosten-Pauschbetrag und einem Krankenversicherungsfreibetrag für Betriebsrenten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assessment and church-tax settings come from Taxes. Church tax is estimated before its special-expense deduction. Child allowances entered here affect surcharge calculations only. Pension income is taxed together, with one expense allowance and one occupational health exemption."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assessment and church-tax settings come from Taxes. Church tax is estimated before its special-expense deduction. Child allowances entered here affect surcharge calculations only. Pension income is taxed together, with one expense allowance and one occupational health exemption."
          }
        }
      }
    },
