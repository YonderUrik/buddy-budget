    "give_your_savings_a_name_a_trip_a_home_a_717b28" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deinen Ersparnissen einen Namen: eine Reise, eine Wohnung, ein Notgroschen. Wähle, aus welchen Konten oder Anlagen das Geld kommt, und sieh, wann du es erreichst, ob deine Ersparnis für alles reicht und was es für dein Ziel ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give your savings a name: a trip, a home, a fund for the unexpected. Choose which accounts or investments the money comes from and see when you get there, whether your savings cover everything and what it changes for your finish line."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai un nome ai tuoi risparmi: un viaggio, la casa, un fondo per gli imprevisti. Scegli da quali conti o investimenti arrivano i soldi e vedi quando ci arrivi, se il risparmio basta per tutto e cosa cambia per il traguardo."
          }
        }
      }
    },
    "give_your_savings_a_name_a_trip_a_home_a_76d64a" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deinen Ersparnissen einen Namen: eine Reise, eine Wohnung, ein Notgroschen. Wähle, aus welchen Konten oder Anlagen das Geld kommt, und sieh, wann du es erreichst und was es für den Tag ändert, an dem du aufhörst zu arbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give your savings a name: a trip, a home, a fund for the unexpected. Choose which accounts or investments the money comes from and see when you get there and what it changes for the day you stop working."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai un nome ai tuoi risparmi: un viaggio, la casa, un fondo per gli imprevisti. Scegli da quali conti o investimenti arrivano i soldi e vedi quando ci arrivi e cosa cambia per il giorno in cui smetti di lavorare."
          }
        }
      }
    },
