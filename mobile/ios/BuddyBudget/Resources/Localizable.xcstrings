    "we_look_for_payments_with_the_same_amoun_19dfb0" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir suchen nach wöchentlichen, monatlichen, vierteljährlichen oder jährlichen Zahlungen mit gleichem Betrag. Dafür sind mindestens drei Monate Umsatzhistorie nötig (zwei Jahre für jährliche Zahlungen). Fehlende Abos kannst du manuell hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We look for payments with the same amount recurring weekly, monthly, quarterly or annually. At least three months of transactions are needed (two years for annual payments). Add any missing subscriptions manually."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerchiamo nei tuoi movimenti gli addebiti che tornano con lo stesso importo, ogni settimana, mese, trimestre o anno. Servono almeno tre mesi di movimenti (due anni, per quelli annuali). Se ne hai uno che non compare, aggiungilo a mano."
          }
        }
      }
    },
