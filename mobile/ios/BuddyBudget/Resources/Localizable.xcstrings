    "when_the_app_is_fairly_sure_it_assigns_t_7e182f" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die App ziemlich sicher ist, ordnet sie die Kategorie automatisch zu. Unter „Kategorisieren“ → „Von der App zugeordnet“ kannst du sie prüfen und ändern. Die übrigen wählst du Karte für Karte selbst. In den Einstellungen kannst du die automatische Zuordnung ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the app is fairly sure, it assigns the category automatically. You can review and change it in Categorize, under “Assigned by the app”. You choose the others, one card at a time. To always choose yourself, turn this off in Settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l'app è abbastanza sicura mette la categoria da sola, e la ritrovi in Categorizza, sotto «Messe dall'app», dove puoi cambiarla. Le altre le scegli tu, una carta alla volta. Se preferisci scegliere sempre tu, lo spegni in Impostazioni."
          }
        }
      }
    },
