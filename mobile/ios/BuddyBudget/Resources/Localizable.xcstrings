    "under_italian_rules_benefits_from_contri_1018e2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach italienischen Regeln werden Leistungen aus Beiträgen seit 2007 mit 15 %% besteuert, ab dem 16. Teilnahmejahr um 0,30 Prozentpunkte jährlich reduziert, bis auf 9 %%. Es zählt der erste Beitritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under Italian rules, benefits from contributions since 2007 are taxed at 15%%, reduced by 0.30 percentage points for each year beyond 15 years of participation, down to 9%%. Count from first enrolment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sui contributi dal 2007 l'imposta in uscita è il 15%%, ridotta di 0,30 punti per ogni anno oltre il quindicesimo di partecipazione, fino al 9%%. Conta dalla prima adesione."
          }
        }
      }
    },
    "under_italian_rules_company_held_tfr_is_4b1aca" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach italienischen Regeln wird beim Arbeitgeber verbliebenes TFR jährlich um 1,5 %% plus 75 %% der Inflation aufgewertet; auf die Aufwertung fällt eine Ersatzsteuer an. Dieser Vergleich unterstellt konstante Inflation und schließt die je nach Fall unterschiedlichen Auszahlungssteuern aus. Die Regeln sollten fachlich geprüft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under Italian rules, company-held TFR is revalued annually by 1.5%% plus 75%% of inflation, with substitute tax on the revaluation. This comparison assumes constant inflation and excludes withdrawal taxes, which differ between cases. Validate the rules with a professional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In azienda il TFR si rivaluta ogni anno dell'1,5%% più il 75%% dell'inflazione, con un'imposta sostitutiva sulla rivalutazione. Il confronto usa un'inflazione costante e non include le tasse all'uscita (diverse nei due casi). Regole da validare con un professionista."
          }
        }
      }
    },
    "under_italian_rules_losses_can_offset_ga_b6b416" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach italienischen Regeln können Verluste bis zum 31. Dezember des vierten Folgejahres mit Gewinnen aus Aktien, Anleihen und ETCs verrechnet werden (nicht mit ETF-Gewinnen). Beträge werden auf eine Steuerbasis von 26 %% umgerechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under Italian rules, losses can offset gains from shares, bonds and ETCs (not ETF gains) until 31 December of the fourth following year. Amounts are adjusted to a 26%% tax basis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le minusvalenze di un anno si possono usare fino al 31 dicembre del quarto anno dopo, per non pagare tasse sulle plusvalenze di azioni, obbligazioni ed ETC (non sui guadagni degli ETF). Gli importi sono portati all'aliquota del 26%%."
          }
        }
      }
    },
    "under_italian_rules_these_are_investment_408dee" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach italienischen Regeln sind dies Kapitalerträge: vollständig besteuert und nicht mit dem Verlusttopf verrechenbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under Italian rules, these are investment income: fully taxed and not eligible for loss-pool offsets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono redditi di capitale: tassati per intero, non si compensano con lo zaino."
          }
        }
      }
    },
    "under_the_fixed_rule_the_three_lines_coi_74eb79" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der festen Regel liegen die drei Linien übereinander; bei den anderen fächern sie sich auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under the fixed rule the three lines coincide; under other rules they spread out."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la regola fissa le tre linee coincidono; con le altre si aprono a ventaglio."
          }
        }
      }
    },
    "under_the_italian_model_unrealised_gains_ae1e4b" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im italienischen Modell fallen auf unrealisierte Gewinne meist 26 %% Steuer an, bei Staatsanleihen 12,5 %%, jedoch erst beim Verkauf. Dies schätzt die Steuer bei einem vollständigen Verkauf heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under the Italian model, unrealised gains generally incur 26%% tax, or 12.5%% for government bonds, only when sold. This estimates tax if you sold everything today."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sui guadagni non ancora incassati pagheresti un'imposta (in genere 26%%, 12,5%% sui titoli di Stato) solo vendendo. Qui è la stima di quanto sarebbe se vendessi tutto oggi."
          }
        }
      }
    },
