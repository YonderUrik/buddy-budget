    "accounts_transactions_investments_catego_050c5e" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten, Umsätze, Anlagen, Kategorien, Regeln, Budgets und Vermögenshistorie werden endgültig gelöscht. Bankverbindungen werden widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts, transactions, investments, categories, rules, budgets and wealth history are permanently deleted. Bank connections are revoked."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono cancellati per sempre conti, transazioni, investimenti, categorie, regole, budget e storico del patrimonio. I collegamenti con le banche vengono revocati."
          }
        }
      }
    },
    "accounts_transactions_investments_catego_7896b4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten, Umsätze, Anlagen, Kategorien und Regeln wurden endgültig gelöscht und deine Bankverbindungen widerrufen. Danke, dass du BuddyBudget genutzt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts, transactions, investments, categories and rules have been permanently deleted and your bank connections revoked. Thanks for using BuddyBudget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conti, transazioni, investimenti, categorie e regole sono stati eliminati definitivamente e i collegamenti con le banche sono stati revocati. Grazie per aver usato BuddyBudget."
          }
        }
      }
    },
    "accounts_transactions_investments_catego_df9fae" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöscht werden Konten, Umsätze, Anlagen, Kategorien, Regeln, Schulden und Bankverbindungen. Um sie zu behalten, melde dich einfach an; eine Kopie kannst du in den Einstellungen exportieren. Wenn du BuddyBudget nicht mehr nutzen möchtest, musst du nichts tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts, transactions, investments, categories, rules, debts and bank connections are deleted. To keep them, just sign in; to keep a copy, you can export them from Settings. If you no longer want to use BuddyBudget, you don't need to do anything."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliminano conti, transazioni, investimenti, categorie, regole, debiti e collegamenti con le banche. Per tenerli basta accedere; per conservarne una copia puoi esportarli da Impostazioni. Se non vuoi più usare BuddyBudget non devi fare nulla."
          }
        }
      }
    },
