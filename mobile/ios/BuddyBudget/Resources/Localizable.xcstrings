    "it_starts_from_the_portfolio_s_daily_ret_432549" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgangspunkt ist die tägliche Rendite des Portfolios ohne Einfluss von Ein- und Auszahlungen (TWR, wie bei den Renditen). Tage ohne investiertes Kapital und ruhige Wochenenden werden ausgelassen: Bei geschlossenen Märkten bewegt sich nichts, und sie würden das Risiko senken. Es werden mindestens %1$@ Tage benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It starts from the portfolio's daily return without the effect of deposits and withdrawals (TWR, the same as in Returns). Days with nothing invested and flat weekends are skipped: with markets closed nothing moves and they would lower the risk. At least %1$@ days are needed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si parte dal rendimento giornaliero del portafoglio senza l'effetto dei versamenti e dei prelievi (il TWR, lo stesso dei rendimenti). Si scartano i giorni senza nulla di investito e i weekend fermi: con i mercati chiusi non c'è movimento e abbasserebbero il rischio. Servono almeno %1$@ giorni."
          }
        }
      }
    },
    "it_takes_at_least_three_months_of_transa_53c689" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür braucht es mindestens drei Monate Umsätze, oder du trägst deine Ersparnis in den Annahmen der Antworten ein. Bis dahin zählen die Sparziele, was du schon zurückgelegt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It takes at least three months of transactions, or enter your savings in the Answers assumptions. Meanwhile your goals keep track of what you've already set aside."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono almeno tre mesi di movimenti, oppure scrivi il tuo risparmio nelle ipotesi delle Risposte. Intanto gli obiettivi tengono il conto di quanto hai già messo da parte."
          }
        }
      }
    },
    "it_will_be_added_to_your_securities_usin_cc4e2e" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird mit der gefundenen Notierung zu deinen Wertpapieren hinzugefügt; historische Kurse werden geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will be added to your securities using the listing found, and historical prices will be downloaded."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo aggiungo ai tuoi strumenti con la quotazione trovata, e scarico i prezzi storici."
          }
        }
      }
    },
    "italian_annual_stamp_duty_of_0_2_on_cust_3fc76f" : {
