    "a_fixed_term_payout_ends_at_the_selected_80180c" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein befristeter Auszahlungsplan endet im gewählten Alter; danach entstehen daraus keine Renteneinkünfte mehr. Gib bei lebenslanger Rente den Anbieterbetrag nach der gewählten Kapitalauszahlung ein. Bei gemischt geförderten und ungeförderten Beiträgen wird der steuerpflichtige Betrag aus der Anbieterbescheinigung benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fixed-term payout ends at the selected age and then contributes no pension income. For a lifetime payout, enter the provider's amount after the chosen lump sum. Payments from mixed funded and unfunded contributions require the taxable amount from the provider statement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fixed-term payout ends at the selected age and then contributes no pension income. For a lifetime payout, enter the provider's amount after the chosen lump sum. Payments from mixed funded and unfunded contributions require the taxable amount from the provider statement."
          }
        }
      }
    },
