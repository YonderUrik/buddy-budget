    "annual_cost_value_ter_value_0_2_italian_7a68da" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jahreskosten = Wert × TER + Wert × 0,2 %% italienische Stempelsteuer für Depotbestände. Die Kostenwirkung vergleicht Wert × (1 + Rendite)^Jahre mit Wert × (1 + Rendite − Kosten)^Jahre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annual cost = value × TER + value × 0.2%% Italian stamp duty for custody holdings. Cost drag compares value × (1 + return)^years with value × (1 + return − cost)^years."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costo annuo = valore × TER + valore × 0,2%% di bollo (per le posizioni in deposito titoli). L'erosione confronta valore × (1 + rendimento)^anni con valore × (1 + rendimento − costo)^anni."
          }
        }
      }
    },
