    },
    "if_it_is_not_listed_you_can_track_the_ac_d9706c" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Falls sie fehlt, kannst du das Konto manuell führen und Umsätze aus einer Datei importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " If it is not listed, you can track the account manually and import transactions from a file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Se non c'è, puoi tenere il conto a mano e importare i movimenti da un file."
          }
        }
      }
    },
    "if_one_assumption_changes_the_date_signi_927b81" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Annahme das Datum stark verschiebt, ist das Ergebnis weniger belastbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If one assumption changes the date significantly, put less confidence in the result."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se un'ipotesi cambia molto la data, fidati meno del risultato."
          }
        }
      }
    },
    "if_reading_fails_i_authorize_automatic_a_2519c4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls das Einlesen fehlschlägt, stimme ich der automatischen KI-Analyse der vollständigen Datei über OpenRouter zu, einschließlich personenbezogener Daten, ohne Speicherung beim Anbieter. Nach der Prüfung werden die Daten automatisch importiert und der Support erhält einen technischen Bericht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If reading fails, I authorize automatic AI analysis of the complete file through OpenRouter, including any personal data, with no provider retention. After validation, data is imported automatically and support receives a technical report."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la lettura fallisce, autorizzo l'analisi AI automatica del file completo tramite OpenRouter, inclusi eventuali dati personali, senza conservazione presso il provider. Dopo i controlli i dati vengono importati automaticamente e il supporto riceve un report tecnico."
          }
        }
      }
    },
    "if_savings_dominate_growth_depends_on_wh_2279ae" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwiegen Ersparnisse, hängt das Wachstum von deinem steuerbaren Sparverhalten ab. Überwiegt der Rest, hängt es von den Märkten ab. Ein negativer Rest in einem Monat spiegelt fallende Märkte wider, keine negativen Ersparnisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If savings dominate, growth depends on what you put aside, which you can control. If the rest dominates, it depends on markets. A negative remainder in a month reflects a market decline, not negative savings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la parte «risparmio» domina, la tua crescita dipende da quanto metti da parte, che puoi controllare. Se domina il «resto», dipende dai mercati. Un mese con il resto negativo non è una perdita tua: è il mercato che scende."
          }
        }
      }
    },
    "if_savings_dominate_growth_depends_on_yo_50adba" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwiegen Ersparnisse, hängt das Wachstum von dir ab – dem verlässlichsten Hebel. Überwiegt der Markt, profitierst oder leidest du durch etwas, das du nicht steuern kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If savings dominate, growth depends on you—the most reliable lever. If markets dominate, you benefit or suffer from something you cannot control."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se domina il risparmio, la crescita dipende da te: è la leva più sicura. Se domina il mercato, stai beneficiando (o soffrendo) di qualcosa che non controlli."
          }
        }
      }
    },
    "if_the_actual_balance_differs_from_the_s_1fd8ff" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die tatsächliche Restschuld vom Plan abweicht, etwa wegen ausgefallener Raten oder Sondertilgungen, gib sie hier ein. Der Plan wird ab dort neu berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the actual balance differs from the schedule (missed payments, pauses, partial repayments), enter it here to restart the schedule from there."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il residuo reale è diverso da quello del piano (rate saltate, sospensioni, estinzioni parziali), indicalo: il piano riparte da lì."
          }
        }
      }
    },
    "if_the_bar_exceeds_the_marker_that_posit_f8d3e6" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersteigt der Balken die Markierung, trägt die Position stärker zum Risiko als zum Wert bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the bar exceeds the marker, that position contributes more to risk than to value."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la barra supera il trattino, quella posizione pesa sul rischio più di quanto pesi sul valore."
          }
        }
      }
    },
    "if_the_file_changed_or_the_previous_resu_6fedbf" : {
