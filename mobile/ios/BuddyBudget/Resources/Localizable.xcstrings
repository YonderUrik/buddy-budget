    "twr_mwr_and_inflation_adjusted_returns_u_6b819f" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TWR, MWR und inflationsbereinigte Renditen anhand der Inflation im Produktland (Italien oder Deutschland, Eurostat-Index), mit Erklärungen beim Überfahren. Die Werte folgen dem Datum im Diagramm; durch Ziehen lässt sich ein Zeitraum auswählen, auch für Risiko und Monatsrenditen. Zeigt außerdem, welchen Wert das Portfolio hätte, wenn Kosten und Steuern investiert geblieben wären."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TWR, MWR and inflation-adjusted returns using the product country’s inflation (Italy or Germany, Eurostat index), with hover explanations. Figures follow the chart date; drag to select a range, including for risk and monthly returns. Also shows what your investments would be worth if costs and taxes had remained invested."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendimenti TWR, MWR e al netto dell'inflazione del paese del prodotto (Italia o Germania, indice Eurostat), con spiegazioni su hover. I numeri seguono la data del grafico; trascina per selezionare un intervallo, anche per rischio e rendimenti mensili. Mostra anche quanto varresti se costi e imposte fossero rimasti investiti."
          }
        }
      }
    },
