    "made_a_mistake_undo_before_the_choice_is_a43079" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler gemacht? Mache die Auswahl innerhalb weniger Sekunden vor dem Speichern rückgängig. Wähle „Immer diese Kategorie verwenden“, um den Händler automatisch zuzuordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made a mistake? Undo before the choice is saved, within a few seconds. Select “Always use this category” to categorise this merchant automatically."
          }
        },
        "it" : {
