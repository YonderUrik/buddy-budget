    "flexibility_has_a_price_in_the_worst_10_0a73dc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexibilität hat ihren Preis: In den schlechtesten 10 %% der Szenarien können die Ausgaben gegenüber dem ersten Jahr um %1$@ oder mehr sinken."
          }
        },
        "en" : {
          "stringUnit" : {
