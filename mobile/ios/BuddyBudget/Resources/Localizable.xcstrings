          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un indice di confronto si usano solo i giorni in cui ci sono entrambi i prezzi. La correlazione (da −1 a 1) dice se vanno nella stessa direzione; il beta quanto si muove il portafoglio per ogni 1%% dell'indice."
          }
        }
      }
    },
