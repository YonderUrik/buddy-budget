    "suggests_categories_for_new_synced_and_i_e20a29" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt Kategorien für neue synchronisierte und importierte Buchungen vor. Bei Unsicherheit entscheidest du. Auf Wunsch weist die App bei hoher Sicherheit die Kategorie automatisch zu; du findest sie unter Kategorisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests categories for new synced and imported transactions. You choose when confidence is low; optionally, the app assigns high-confidence categories automatically for review in Categorize."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propone una categoria per i movimenti nuovi di sincronizzazioni e importazioni. Quelle in dubbio le scegli tu; se vuoi, quando è abbastanza sicura l'app la mette da sola e la ritrovi in Categorizza."
          }
        }
      }
    },
    "suggests_categories_for_new_transactions_606d96" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt Kategorien für neue Umsätze aus Synchronisierungen und Importen vor. Du bestätigst immer selbst: Nichts wird automatisch kategorisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests categories for new transactions from syncs and imports. You always confirm: nothing is categorised automatically."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propone una categoria per i movimenti nuovi di sincronizzazioni e importazioni. Sei sempre tu a confermare: nulla viene categorizzato da solo."
          }
        }
      }
    },
