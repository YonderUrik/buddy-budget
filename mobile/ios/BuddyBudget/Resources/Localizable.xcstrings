          "stringUnit" : {
            "state" : "translated",
            "value" : "I save the %1$@ recognised lines and skip the other %2$@: they do not enter your accounts. You can fix them in the file and upload it again later, with no duplicates. The format stays saved for your next files."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo le %1$@ righe riconosciute e salto le altre %2$@: non entrano nei conti. Potrai correggerle nel file e ricaricarlo più avanti, senza doppioni. Il formato resta salvato per i prossimi file."
          }
        }
      }
    },
