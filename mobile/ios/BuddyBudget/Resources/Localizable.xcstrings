    "a_negative_market_component_reflects_fal_e4f5a6" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein negativer Marktanteil zeigt sinkende Wertpapierwerte und keinen von dir verursachten Geldabfluss."
