    "enter_only_foreign_tax_confirmed_as_cred_008cb5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse nur ausländische Steuern, deren Anrechenbarkeit auf diese steuerpflichtigen Erträge nach DBA-Grenzen, Erstattungen, Pauschbeträgen und Verlusten bestätigt ist. Erfasste Quellensteuern gelten nicht automatisch als anrechenbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter only foreign tax confirmed as creditable for these taxable earnings after treaty limits, refunds, allowances and losses. Recorded withholding is not automatically treated as creditable."
          }
        },
        "it" : {
          "stringUnit" : {
