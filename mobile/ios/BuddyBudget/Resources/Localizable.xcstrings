    "an_average_return_every_year_produces_a_e46007" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine gleichbleibende Durchschnittsrendite ergibt eine glatte Linie. Märkte verhalten sich anders: Ein schlechter Ruhestandsbeginn wiegt schwerer als ein schlechtes Ende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An average return every year produces a smooth line. Markets do not work that way: a bad start to retirement matters more than a bad ending."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un calcolo con un rendimento «medio» ogni anno dà una linea liscia, ma i mercati non vanno così: un brutto inizio pensione pesa molto più di una brutta fine."
          }
        }
      }
    },
