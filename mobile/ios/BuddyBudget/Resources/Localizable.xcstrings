    "small_annual_costs_may_be_invisible_on_s_b76cb3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine jährliche Kosten sind auf Abrechnungen oft nicht sichtbar, summieren sich aber mit wachsendem Kapital. Langfristig wiegen sie schwerer als viele Anlageentscheidungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small annual costs may be invisible on statements, but compound as capital grows. Over long periods they matter more than many investment choices."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono piccoli ogni anno e non li vedi in nessun estratto conto, ma si accumulano sul capitale che cresce. Su orizzonti lunghi pesano più di molte scelte di investimento."
          }
        }
      }
