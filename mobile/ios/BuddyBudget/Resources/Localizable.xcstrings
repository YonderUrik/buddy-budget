    "assigned_0_of_1_where_you_keep_it_does_n_caf7a4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugewiesen: %1$@ von %2$@. Wo du es aufbewahrst, ändert die Kontostände nicht: es ist nur eine Markierung. Bei Wertpapieren zählen wir den Wert nach der geschätzten Steuer bei einem Verkauf heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assigned %1$@ of %2$@. Where you keep it does not change account balances: it's just a label. For securities we count the value net of the estimated tax if you sold them today."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegnati %1$@ di %2$@. Dove li tieni non cambia il saldo dei conti: è solo un'etichetta. Per i titoli contiamo il valore al netto dell'imposta stimata se li vendessi oggi."
          }
        }
      }
    },
