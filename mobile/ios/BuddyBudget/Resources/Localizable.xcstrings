    "above_0_in_real_terms_projections_become_859ee4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei mehr als %1$@ realer Rendite werden die Projektionen optimistisch: Langfristig erzielten weltweite Aktienmärkte durchschnittlich etwa 5 %% reale Rendite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above %1$@ in real terms, projections become optimistic: over the long term, global equities have returned around 5%% a year after inflation on average."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopra %1$@ reale le proiezioni diventano ottimistiche: nel lungo periodo le borse mondiali hanno reso in media intorno al 5%% reale."
          }
        }
      }
    },
    "above_1_it_moves_more_than_the_market_be_32ab55" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über 1 schwankt es stärker als der Markt, unter 1 weniger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above 1, it moves more than the market; below 1, less."
          }
        },
