    "all_spending_and_liquid_savings_are_in_t_329379" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben und liquide Sparbeträge sind in heutigen Euro angegeben. Erfasse nur investierbares Kapital, ohne bereits unter Altersvorsorge erfasste Verträge. Renteneinnahmen beginnen zum jeweiligen Zahlungsbeginn. Dieses feste Szenario ist keine Garantie oder Erfolgswahrscheinlichkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All spending and liquid savings are in today's euros. Enter investable capital only, excluding pension contracts already listed in Pensions. Pension income starts at each contract's payment date. This deterministic scenario is not a guarantee or a success probability."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All spending and liquid savings are in today's euros. Enter investable capital only, excluding pension contracts already listed in Pensions. Pension income starts at each contract's payment date. This deterministic scenario is not a guarantee or a success probability."
