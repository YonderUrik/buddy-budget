    "read_and_accept_the_documents_to_keep_us_009a8d" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies und akzeptiere die Dokumente, um BuddyBudget weiter zu nutzen. Wenn du nicht zustimmst, kannst du deine Daten herunterladen und dein Konto löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read and accept the documents to keep using BuddyBudget. If you do not accept, you can download your data and delete your account."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per continuare a usare BuddyBudget leggi i documenti e accettali. Se non vuoi accettare puoi scaricare i tuoi dati ed eliminare l'account."
          }
        }
      }
    },
    "read_from_the_annual_swing_below_0_low_f_1f6b36" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgelesen an der jährlichen Schwankung: unter %1$@ niedrig (zum Beispiel Anleihen), bis %2$@ mittel, bis %3$@ hoch (globale Aktien liegen bei etwa %4$@), darüber sehr hoch. Diese Schwellen haben wir selbst gewählt, sie sind keine offizielle Einstufung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read from the annual swing: below %1$@ low (for example bonds), up to %2$@ medium, up to %3$@ high (global equities are around %4$@), above that very high. These reading thresholds are our own choice, not an official classification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si legge l'oscillazione annua: sotto %1$@ basso (per esempio obbligazioni), fino a %2$@ medio, fino a %3$@ alto (l'azionario mondiale sta intorno al %4$@), oltre molto alto. Sono soglie di lettura scelte da noi, non una classificazione ufficiale."
          }
        }
      }
    },
