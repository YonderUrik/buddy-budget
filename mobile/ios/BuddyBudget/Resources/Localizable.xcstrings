          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi tracciarne più di uno (per esempio un fondo negoziale e un PIP): il patrimonio netto li somma."
          }
        }
      }
    },
    "track_statutory_occupational_riester_rur_cff7c2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse gesetzliche Rente, Betriebsrente, Riester, Rürup, private Renten und Altersvorsorgedepots getrennt. Rentenansprüche sind künftige Einnahmen, kein liquides Vermögen. Vertragskapital wird nur hier angezeigt und nicht automatisch zum Portfolio oder Nettovermögen addiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track statutory, occupational, Riester, Rürup, private pensions and Altersvorsorgedepots separately. Pension entitlements are future income, not liquid assets. Contract capital is shown only here and is not added automatically to your portfolio or net worth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track statutory, occupational, Riester, Rürup, private pensions and Altersvorsorgedepots separately. Pension entitlements are future income, not liquid assets. Contract capital is shown only here and is not added automatically to your portfolio or net worth."
          }
        }
      }
    },
