    "success_probability_is_the_share_of_scen_d2c4c3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erfolgswahrscheinlichkeit ist der Anteil der Szenarien, in denen das Vermögen bis zum Ende reicht. Die Bänder zeigen ungünstige (10.), typische (50.) und günstige (90. Perzentil) Ergebnisse je Jahr. Eine hohe Wahrscheinlichkeit ist keine Garantie; eine niedrigere zeigt deinen Spielraum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Success probability” is the share of scenarios where assets last until the end. The bands show unlucky (10th), typical (50th) and lucky (90th percentile) outcomes each year. A high probability is no guarantee; a lower one shows how much margin you have."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Probabilità di successo» = quota di scenari in cui il patrimonio non si esaurisce prima della fine. Le fasce mostrano i casi sfortunati (10°), tipici (50°) e fortunati (90° percentile) per ogni anno. Una probabilità molto alta non è una garanzia; una più bassa dice di quanto margine hai."
          }
        }
      }
    },
    "success_probability_withdrawal_rules_por_2096ba" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfolgswahrscheinlichkeit, Entnahmeregeln, Portfoliorisiko"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "success probability, withdrawal rules, portfolio risk"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "probabilità di successo, regole di prelievo, rischio del portafoglio"
          }
        }
      }
    },
    "success_scenarios_where_wealth_lasts_typ_fdd8ca" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfolg: Szenarien, in denen das Vermögen reicht. Typische maximale Kürzung: größter Ausgabenrückgang im typischen Fall. Kürzung in den schlechtesten 10 %%: derselbe Wert für besonders ungünstige Verläufe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Success: scenarios where wealth lasts. Typical maximum cut: the largest spending reduction in the typical case. Worst 10%% cut: the same measure for the unluckiest scenarios."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Successo: in quanti scenari il patrimonio dura. Taglio massimo tipico: di quanto scende la spesa, nel punto peggiore, nel caso tipico. Taglio nel 10%% dei casi peggiori: lo stesso, ma per gli scenari più sfortunati."
          }
        }
      }
    },
