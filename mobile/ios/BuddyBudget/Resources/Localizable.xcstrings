          }
        }
      }
    },
    "capital_that_reaches_the_fire_target_in_d77716" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapital, das ohne weitere Einzahlungen in N Jahren das FIRE-Ziel erreicht. Hast du es bereits, kannst du auf weiteres Ruhestandssparen verzichten und nur laufende Ausgaben decken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capital that reaches the FIRE target in N years without further contributions. If you already have it, you can stop saving for retirement and cover only current spending."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il capitale che, lasciato crescere senza versare altro, arriva da solo al numero FIRE fra N anni. Se ce l'hai già puoi smettere di risparmiare per la pensione (e coprire solo le spese correnti)."
          }
        }
      }
    },
