    "a_rule_with_guardrails_cut_withdrawals_b_8710a9" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Regel mit Leitplanken: Bei zu hoher Entnahme im Verhältnis zum Vermögen wird um 10 %% gekürzt, bei niedriger Entnahme erhöht. Begrenzt drastische Kürzungen, erfordert aber Flexibilität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rule with guardrails: cut withdrawals by 10%% when too high relative to wealth, and increase them when low. Limits drastic cuts but requires flexibility."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regola con paletti: se il prelievo diventa troppo alto rispetto al patrimonio lo tagli del 10%%, se è basso puoi alzarlo. Evita i tagli drastici ma richiede flessibilità."
          }
        }
      }
    },
