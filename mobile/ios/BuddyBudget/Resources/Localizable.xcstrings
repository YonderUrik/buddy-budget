        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With less than a year of data, figures are indicative. History excludes crises this portfolio has not experienced. Daily VaR and CVaR do not describe slow, prolonged declines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con meno di un anno di dati i numeri sono indicativi. Il passato non include crisi che non hai vissuto con questo portafoglio. VaR e CVaR giornalieri non dicono nulla sui cali lenti e lunghi."
          }
        }
      }
    },
