    "generates_thousands_of_possible_futures_58c584" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugt Tausende mögliche Zukunftsverläufe mit zufälligen Renditen und zählt, wie oft das Vermögen durch den Ruhestand reicht. So werden Risiken sichtbar, die eine einzelne Durchschnittsrendite verdeckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generates thousands of possible futures with random returns and counts how often wealth lasts through retirement, revealing risk hidden by a single average return."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invece di un solo futuro «medio», genera migliaia di futuri possibili con rendimenti che oscillano a caso, e conta in quanti il patrimonio dura per tutta la pensione. Mostra il rischio che un calcolo con un solo rendimento nasconde."
          }
        }
      }
    },
