    "if_this_was_a_mistake_you_can_enable_the_7ce369" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Falls das ein Versehen war, kannst du sie unter Einstellungen → Benachrichtigungen wieder aktivieren. Service-E-Mails (z. B. Anmeldelinks) bleiben aktiv, damit du dein Konto nutzen kannst."
          }
