    "i_save_the_0_recognised_lines_and_skip_t_d09d5c" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich speichere die %1$@ erkannten Zeilen und überspringe die anderen %2$@: Sie gehen nicht in deine Konten ein. Du kannst sie in der Datei korrigieren und später erneut hochladen, ohne Duplikate. Das Format bleibt für deine nächsten Dateien gespeichert."
