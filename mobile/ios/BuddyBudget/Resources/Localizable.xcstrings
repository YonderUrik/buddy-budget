    "estimate_by_ex_dividend_date_net_of_ital_bd1306" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzung nach Ex-Tag, nur nach italienischer Steuer: Ausländische Dividenden können zusätzlich Quellensteuer unterliegen. Anleiherückzahlungen sind Kapitalrückflüsse, keine Erträge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimate by ex-dividend date, net of Italian tax only: foreign dividends may also have source-country withholding. Bond redemption returns principal, not income."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima per data di stacco, netta della sola imposta italiana: sui dividendi esteri c'è anche la ritenuta del paese d'origine. Il rimborso di un'obbligazione è capitale che torna, non un provento."
          }
        }
      }
    },
