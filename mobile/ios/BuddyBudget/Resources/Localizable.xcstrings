    "withdrawals_require_sales_and_gains_are_f17690" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entnahmen erfordern Verkäufe, deren Gewinne steuerpflichtig sind (heute etwa %1$@ deines Vermögens). Das Ziel steigt daher auf %2$@: den Bruttobetrag, der den benötigten Nettobetrag ergibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Withdrawals require sales, and gains are taxable (about %1$@ of your wealth today). The target therefore rises to %2$@, the gross amount needed to leave the required net amount."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiché per prelevare devi vendere e sulle plusvalenze si pagano le imposte (circa %1$@ del tuo patrimonio oggi), il numero sale a %2$@: è quello che devi avere lordo per ritrovarti in mano la cifra giusta dopo le tasse."
          }
        }
      }
    },
