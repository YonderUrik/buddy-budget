    "enter_matched_acquisition_disposal_lots_2e9f8e" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse zugeordnete Kauf- und Verkaufslots in EUR, auch bei Krypto-Tauschgeschäften. Nach mehr als einem Jahr gilt Steuerfreiheit; die jährliche Freigrenze von 1.000 € ist kein Freibetrag. Gewerblicher Handel, Staking-Erträge, Lending, Mining, NFTs und Derivate sind gesondert zu prüfen. Dieses Szenario wird nicht automatisch aus dem Portfolio übernommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter matched acquisition/disposal lots in EUR, including crypto-to-crypto exchanges. More than one year is exempt; the annual €1,000 private-sale threshold is not a deduction. Business trading, staking rewards, lending, mining, NFTs and derivatives need separate treatment. This scenario is not imported automatically from the portfolio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter matched acquisition/disposal lots in EUR, including crypto-to-crypto exchanges. More than one year is exempt; the annual €1,000 private-sale threshold is not a deduction. Business trading, staking rewards, lending, mining, NFTs and derivatives need separate treatment. This scenario is not imported automatically from the portfolio."
          }
        }
      }
    },
