    "sortino_0_is_similar_but_counts_only_dow_224a29" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino%1$@ ist ähnlich, berücksichtigt aber nur Abwärtsschwankungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino%1$@ is similar but counts only downward fluctuations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino%1$@ è lo stesso ma conta solo le oscillazioni verso il basso, che sono quelle che temi."
          }
        }
      }
    },
    "sortino_906a3d" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortino"
