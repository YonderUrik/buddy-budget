    "italian_withholding_regime_most_italian_de794e" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Italienisches Abzugsverfahren (die meisten italienischen Broker): Der Broker behält bei jedem Verkauf Steuern ein; Verluste verrechnen nur später realisierte Gewinne. Italienisches Veranlagungsverfahren (meist ausländische Broker wie IBKR oder DEGIRO): Zahlung über die Steuererklärung mit Zusammenrechnung des Jahres. Für Krypto gilt stets die Veranlagung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Italian withholding regime (most Italian brokers): the broker withholds tax on each sale, and losses offset only later realised gains. Italian self-assessment regime (usually foreign brokers such as IBKR or DEGIRO): you pay through your tax return and aggregate the year's results. Crypto always uses self-assessment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amministrato (quasi tutti i broker italiani): il broker trattiene le tasse a ogni vendita e una minusvalenza compensa solo le plusvalenze che realizzi dopo. Dichiarativo (di solito i broker esteri, come IBKR o DEGIRO): paghi in dichiarazione e nell'anno si sommano tutte. Le crypto seguono sempre la dichiarazione."
          }
        }
      }
    },
