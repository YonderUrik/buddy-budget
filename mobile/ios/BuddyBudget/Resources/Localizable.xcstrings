    "the_tax_comparison_holds_the_2026_income_da4d29" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Steuervergleich verwendet unverändert den Einkommensteuertarif 2026; er ist keine Steuerberechnung für 2027. Zulagen werden vom Steuervorteil abgezogen, um eine Doppelzählung zu vermeiden. Erstattungen werden nicht automatisch wiederangelegt. Bei mittelbarer Berechtigung muss der gemeinsame Abzug beim Ehepartner gesondert geprüft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tax comparison holds the 2026 income-tax tariff constant; it is not a 2027 tax assessment. Grants are deducted from the tax benefit to avoid double counting. Refunds are not reinvested automatically. For indirect entitlement, the spouse's joint deduction must be assessed separately."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tax comparison holds the 2026 income-tax tariff constant; it is not a 2027 tax assessment. Grants are deducted from the tax benefit to avoid double counting. Refunds are not reinvested automatically. For indirect entitlement, the spouse's joint deduction must be assessed separately."
          }
        }
      }
    },
