    "altersvorsorgedepot_new_contracts_from_2_7f8dca" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altersvorsorgedepot: neue Verträge ab 2027. Dies ist ein Brutto-Planungsszenario, kein 2026 verfügbares Konto. Gib Beiträge und Renditen ausdrücklich an; Zulagen, Steuerentlastungen und die Besteuerung der Auszahlungen werden nicht berechnet. Halte dieses Kapital getrennt von liquiden Anlagen. Die Laufzeit von Auszahlungsplänen und Teilkapitalauszahlungen werden noch nicht modelliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altersvorsorgedepot: new contracts from 2027. This is a gross planning scenario, not an available 2026 account. Enter contributions and returns explicitly; subsidies, tax relief and payout taxation are not calculated. Keep this capital separate from liquid investments. Payout-plan duration and partial lump sums are not modelled yet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altersvorsorgedepot: new contracts from 2027. This is a gross planning scenario, not an available 2026 account. Enter contributions and returns explicitly; subsidies, tax relief and payout taxation are not calculated. Keep this capital separate from liquid investments. Payout-plan duration and partial lump sums are not modelled yet."
          }
        }
      }
    },
