    "time_weighted_return_twr_links_daily_ret_7659ba" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zeitgewichtete Rendite (TWR) verknüpft Tagesrenditen und neutralisiert Käufe und Verkäufe. Sie misst die Anlageentwicklung, ohne Tage mit mehr investiertem Geld stärker zu gewichten. Dieser Wert eignet sich für den Indexvergleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time-weighted return (TWR) links daily returns and neutralises purchases and sales. It measures investment performance without giving more weight to days with more money invested. Use this figure to compare with an index."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rendimento ponderato per il tempo (TWR) concatena i rendimenti giornalieri e neutralizza acquisti e vendite. Misura la performance degli strumenti, senza dare più peso ai giorni in cui avevi più soldi investiti. È il valore da confrontare con un indice."
          }
        }
      }
    },
