    "we_find_them_on_our_own_in_an_account_s_a06aab" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir finden sie selbst in den Umsätzen eines Kontos: was sie pro Monat und Jahr kosten und wann die nächste Abbuchung kommt."
