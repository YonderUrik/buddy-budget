    "measures_portfolio_fluctuations_and_pote_bd1586" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst Portfolioschwankungen und mögliche Verluste an den schlechtesten Tagen und in den schlechtesten Zeiträumen anhand täglicher Anlagekurse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures portfolio fluctuations and potential pain in the worst days and periods, using daily investment prices."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto il portafoglio oscilla e quanto può far male nei giorni e nei periodi peggiori. Si calcola sui prezzi giornalieri dei tuoi investimenti."
          }
        }
      }
    },
    "measures_portfolio_fluctuations_losses_o_f09e43" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst Portfolioschwankungen, Verluste an den schlechtesten Tagen und den Beitrag jeder Position zum Gesamtrisiko."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures portfolio fluctuations, losses on the worst days and each position's contribution to total risk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misure di quanto il portafoglio oscilla e quanto può far male nei giorni peggiori, oltre a quanto ogni posizione pesa sul rischio totale."
          }
        }
      }
    },
