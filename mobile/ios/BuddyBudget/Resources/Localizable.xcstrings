    "technical_name_beta_relative_to_0_1_mean_c50b9e" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fachbegriff: Beta gegenüber %1$@. 1 bedeutet Bewegung wie der Index, 0,5 halb so stark, 1,5 anderthalbmal. Die Korrelation (−1 bis 1) misst, wie ähnlich die Bewegungsrichtung ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical name: beta relative to %1$@. 1 means it moves like the index, 0.5 half as much, 1.5 one and a half times. Correlation (−1 to 1) measures how closely movements follow the same direction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome tecnico: beta rispetto a %1$@. 1 vuol dire che si muove come l'indice, 0,5 la metà, 1,5 una volta e mezza. La correlazione (da −1 a 1) dice quanto i movimenti vanno nella stessa direzione."
          }
        }
      }
    },
    "technical_name_maximum_drawdown_the_larg_d700cd" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fachbegriff: maximaler Drawdown. Größter Rückgang vom Höchstwert deines Portfolios, ohne Einzahlungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical name: maximum drawdown. The largest decline from your portfolio's peak value, excluding contributions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome tecnico: massima perdita dal picco (drawdown). Quanto hai visto scendere il portafoglio, al massimo, rispetto al suo valore più alto. Non conta i versamenti."
          }
        }
      }
    },
    "technical_name_sharpe_ratio_excess_retur_87c377" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fachbegriff: Sharpe Ratio. Mehrertrag gegenüber einem Einlagenkonto je Risikoeinheit. Unter 0,5 ist niedrig, über 1 ist gut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical name: Sharpe ratio. Excess return over a deposit account per unit of risk. Below 0.5 is low; above 1 is good."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome tecnico: Sharpe ratio. Quanto rendimento in più di un conto deposito hai avuto per ogni unità di rischio. Sotto 0,5 è poco, sopra 1 è buono."
          }
        }
      }
    },
    "technical_term_volatility_how_much_the_v_a3e1a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fachbegriff: Volatilität. Wie stark der Wert in einem Jahr üblicherweise nach oben oder unten schwankt. Höhere Werte bedeuten stärkere Schwankungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical term: volatility. How much the value typically moves up or down in a year. Higher values mean a bumpier ride."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome tecnico: volatilità. Di quanto si muove di solito il valore in un anno, in più o in meno. Più è alta, più il percorso è accidentato."
          }
        }
      }
    },
