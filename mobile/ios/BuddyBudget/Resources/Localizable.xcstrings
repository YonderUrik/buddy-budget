    "enter_the_original_principal_rate_and_in_2e0cc1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ursprünglichen Betrag, Zinssatz und Raten an. Wir rekonstruieren den Plan und zeigen vergangene Raten zur Zahlungsbestätigung. Geeignet, wenn du den Vertrag hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the original principal, rate and instalments. We reconstruct the schedule and show past instalments so you can confirm those paid. Best if you have the contract."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci capitale, tasso e rate di quando l'hai preso. Ricostruiamo il piano e vedi quante rate sono già passate: poi confermi quelle che hai pagato. Adatto se hai il contratto sotto mano."
          }
        }
      }
    },
    "enter_the_outstanding_balance_instalment_a02995" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Restschuld, Rate und verbleibende Raten an. Der Plan beginnt heute ohne Historie. Geeignet bei fehlendem oder neu verhandeltem Vertrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the outstanding balance, instalment and remaining payments. The schedule starts today without history. Best if the contract is unavailable or was renegotiated."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci quanto devi ancora restituire, la rata e le rate rimaste. Il piano parte da oggi, senza storico. Adatto se non hai più il contratto o è stato rinegoziato."
          }
        }
      }
    },
