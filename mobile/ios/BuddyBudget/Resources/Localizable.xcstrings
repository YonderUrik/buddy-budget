    "a_calculation_with_a_single_average_retu_ca47e2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Berechnung mit nur einer durchschnittlichen Rendite verdeckt das Risiko. Die Simulation erzeugt Tausende mögliche Entwicklungen und zählt, wie oft dein Vermögen bis zum Ende des Ruhestands reicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A calculation with a single “average” return hides risk. The simulation generates thousands of possible futures and counts how often your assets last through retirement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un calcolo con un solo rendimento «medio» nasconde il rischio. La simulazione genera migliaia di futuri possibili e conta in quanti il patrimonio dura fino alla fine della pensione."
          }
        }
      }
    },
