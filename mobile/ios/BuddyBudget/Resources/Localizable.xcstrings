    "track_multiple_pension_products_for_exam_5d9348" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse mehrere Vorsorgeprodukte (z. B. einen italienischen betrieblichen Fonds und einen PIP): Das Nettovermögen enthält ihre Summe."
          }
        },
        "en" : {
          "stringUnit" : {
