    "to_do_this_we_send_openrouter_only_the_c_09b322" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür senden wir OpenRouter nur den bereinigten Händlernamen (nie Beträge, Daten, IBANs, Notizen oder Personennamen), im Zero-Data-Retention-Modus: Ihn erhalten nur Anbieter, die keine Daten speichern und sie nicht zum Training nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To do this we send OpenRouter only the cleaned-up merchant name (never amounts, dates, IBANs, notes or people's names), in zero data retention mode: only providers that keep no data and don't train on it receive it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per farlo inviamo a OpenRouter solo il nome pulito dell'esercente (mai importi, date, IBAN, note o nomi di persone), in modalità zero data retention: lo ricevono solo fornitori che non conservano i dati e non li usano per l'addestramento."
          }
        }
      }
    },
