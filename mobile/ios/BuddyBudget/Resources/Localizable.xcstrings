    "each_month_change_in_wealth_income_expen_8ace6a" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Monat gilt: Vermögensänderung = Einnahmen − Ausgaben (Ersparnis) + Rest. Der Rest enthält auch nicht erfasste Vorgänge wie Geschenke, Erstattungen und unverbuchte Überträge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each month: change in wealth = income − expenses (savings) + remainder. The remainder also includes items outside recorded transactions, such as gifts, refunds and unrecorded transfers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ogni mese: variazione del patrimonio = entrate − uscite (risparmio) + resto. Il resto è la differenza, quindi include anche tutto ciò che non passa dai movimenti (regali, rimborsi, trasferimenti non registrati)."
          }
        }
      }
    },
