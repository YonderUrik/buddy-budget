    "imports_investments_card_payments_transf_4130b5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiert Anlagen, Kartenzahlungen, Überweisungen, Zinsen und Boni. Der Saldo wird ausgehend von null berechnet: Die Datei enthält weder einen bestätigten Saldo noch die Kontonummer. Nutze diese Quelle nur für ein Trade-Republic-Konto und aktualisiere stets mit dem vollständigen Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imports investments, card payments, transfers, interest and bonuses. The balance is calculated from transactions starting at zero: the file contains neither a certified balance nor the account number. Use this source for one Trade Republic account only and always update with the complete history."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importo investimenti, pagamenti con carta, bonifici, interessi e bonus. Il saldo è calcolato dai movimenti partendo da zero: il file non contiene un saldo certificato né il numero del conto. Usa questa fonte per un solo conto Trade Republic e aggiorna sempre con lo storico completo."
          }
        }
      }
    },
    "imports_purchases_sales_and_any_dividend_141dcb" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiert Käufe, Verkäufe sowie vorhandene Dividenden und Kupons. Die Datei enthält weder Saldo noch Bestände; der Kontostand bleibt unverändert. Verwendet wird das Transaktionsdatum, nicht das Wertstellungsdatum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imports purchases, sales and any dividends or coupons. The file has no balance or holdings, so cash balances remain unchanged. Uses the transaction date, not the settlement date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importo acquisti, vendite e, se presenti, dividendi e cedole. Il file non ha il saldo né le posizioni, quindi la liquidità non cambia. Uso «Data operazione», non la data valuta."
          }
        }
      }
    },
