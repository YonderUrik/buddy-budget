    "money_weighted_return_mwr_calculated_wit_f020b2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geldgewichtete Rendite (MWR), mit XIRR für den gewählten Zeitraum berechnet, berücksichtigt Daten und Beträge deiner Buchungen. Sie kann von der TWR abweichen, wenn du vor einem Anstieg oder Rückgang mehr investiert hast. Sie ist nicht die Diagrammlinie. Ist keine Rendite berechenbar, erscheint ein Strich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Money-weighted return (MWR), calculated with XIRR over the selected period, accounts for transaction dates and amounts. It can differ from TWR if you invested more before a rise or fall. It is not the chart line. A dash appears when no rate can be calculated."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rendimento ponderato per il denaro (MWR), calcolato con XIRR e riportato alla durata del periodo, considera importi e date dei tuoi movimenti. Può differire dal TWR se hai investito di più prima di un rialzo o di un calo. Non è la linea del grafico. Se non esiste un tasso calcolabile, mostriamo un trattino."
          }
        }
      }
    },
