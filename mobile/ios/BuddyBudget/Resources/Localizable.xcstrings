    "capital_needed_to_live_from_wealth_witho_58f7c4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapital, um ohne Arbeit vom Vermögen zu leben. Jahresausgaben ÷ Entnahmesatz: 30.000 € bei 3,5 %% ergeben rund 857.000 €."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capital needed to live from wealth without working. Annual spending ÷ withdrawal rate: €30,000 at 3.5%% gives about €857,000."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il capitale che basterebbe per vivere del solo rendimento del patrimonio, senza più lavorare. Si calcola come spesa annua ÷ tasso di prelievo: con 30.000 € di spesa e il 3,5%%, circa 857.000 €."
          }
        }
      }
    },
    "capital_runs_out_in_retirement_year_0_101d4a" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kapital ist im %1$@. Ruhestandsjahr aufgebraucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capital runs out in retirement year %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
