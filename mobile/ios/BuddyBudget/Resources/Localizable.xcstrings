    "the_share_of_capital_withdrawn_in_your_f_88ae87" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der im ersten Ruhestandsjahr entnommene Kapitalanteil. 4 %% ist die historische US-Regel; für längere Zeiträume und Europa werden vorsichtigere Annahmen von 3–3,5 %% verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The share of capital withdrawn in your first retirement year. 4%% is the historical US rule; longer horizons and Europe call for more cautious assumptions (3–3.5%%)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto del capitale prelevi il primo anno di pensione. 4%% è la regola storica americana; per un orizzonte lungo e per l'Europa si ragiona su valori più prudenti (3-3,5%%)."
          }
        }
      }
    },
    "the_share_of_profit_paid_as_dividends_2d8410" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Dividende ausgeschütteter Gewinnanteil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The share of profit paid as dividends."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte dell'utile distribuita come dividendo."
          }
        }
      }
    },
    "the_share_of_wealth_withdrawn_annually_f_e96f98" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der jährlich für Lebenshaltung entnommene Vermögensanteil. Bei 3,5 %% entnimmst du 3.500 € je 100.000 €. Niedrigere Sätze verlängern die Reichweite, benötigen aber mehr Kapital."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The share of wealth withdrawn annually for living costs. At 3.5%%, you withdraw €3,500 per €100,000. Lower rates help wealth last but require more capital."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quota del patrimonio che prelevi ogni anno per vivere. Con il 3,5%% prelevi 3.500 € ogni 100.000 €. Più è basso, più il patrimonio dura, ma più capitale ti serve."
          }
        }
      }
    },
    "the_sheet_has_too_many_rows_at_most_0_b4c41b" : {
