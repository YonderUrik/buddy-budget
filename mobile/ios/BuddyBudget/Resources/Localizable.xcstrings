    "look_at_success_probability_alongside_ho_1e5bcc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrachte Erfolgswahrscheinlichkeit und mögliche Ausgabenkürzungen in ungünstigen Szenarien gemeinsam. Flexible Regeln halten besser durch, verlangen bei fallenden Märkten aber Einsparungen. Die feste Regel kürzt nie, ist jedoch am anfälligsten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at success probability alongside how far spending may fall in unlucky scenarios. Flexible rules hold up better but require spending cuts when markets decline. The fixed rule never cuts spending but is the most fragile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda due cose insieme: la probabilità di successo e quanto la spesa può calare nei casi sfortunati. Le regole flessibili reggono meglio ma ti chiedono di tagliare le spese quando i mercati scendono; la regola fissa non taglia mai ma è la più fragile."
          }
        }
      }
    },
