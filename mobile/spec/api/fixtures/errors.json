    "request": "DELETE /api/transactions/00000000-0000-4000-8000-000000000000",
    "requestBody": null,
    "status": 404,
    "body": {
      "error": "Movimento non trovato",
      "code": "transaction_not_found"
    }
  },
  "category_not_found": {
    "request": "PATCH /api/categories/00000000-0000-4000-8000-000000000000",
    "requestBody": {
      "name": "x"
    },
    "status": 404,
    "body": {
      "error": "Categoria non trovata",
      "code": "category_not_found"
    }
  },
  "validation_failed": {
    "request": "POST /api/transactions",
    "requestBody": {
      "amount": "abc"
    },
    "status": 400,
    "body": {
      "error": "Invalid input: expected string, received undefined",
      "code": "validation_failed",
      "field": "accountId"
    }
  },
  "category_exists": {
    "request": "POST /api/categories",
    "requestBody": {
      "name": "Spesa",
      "type": "dovuta"
    },
    "status": 409,
    "body": {
      "error": "Categoria già esistente",
      "code": "category_exists"
    }
